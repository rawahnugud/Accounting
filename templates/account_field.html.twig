{# One account picker on the operation form; expects field, kind, travel, cash, parties, f. #}
{% set isCash=field in ['cash','destination'] %}
{% set options=isCash?cash:parties|filter(p=>p.kind==field) %}
{% set optional=kind=='opening_party' or (travel and field=='supplier') %}
<label>{{ (isCash?(field=='destination'?'To bank or safe':(kind=='transfer'?'From bank or safe':'Bank or safe')):field|capitalize)|ui }}{{ (optional?' (optional)')|ui }}
<select name="{{ field }}" {{ optional?'':'required' }}><option value="">{{ 'Choose an account'|ui }}</option>{% for a in options %}<option value="{{ a.id }}" data-currency="{{ a.currency }}" {{ f[field]|default('')==a.id?'selected' }}>{{ a.name }} · {{ a.currency }}</option>{% endfor %}{% if kind=='sale' and field in ['customer','supplier'] %}<option value="new" {{ f[field]|default('')=='new'?'selected' }}>{{ (field=='customer'?'Add a new client':'Add a new supplier')|ui }}</option>{% endif %}</select>

{% if options is empty and not (kind=='sale' and field in ['customer','supplier']) %}<small>{% if info.role=='admin' %}<a href="{{ path('control',{setup:isCash?'cash':'party',branch:branch,kind:field}) }}#setup-{{ isCash?'cash':'party' }}">{{ 'Add'|ui }} {{ (isCash?'a bank or safe':'a '~field)|ui }}</a>{% else %}{{ 'Ask your branch administrator to add'|ui }} {{ (isCash?'a bank or safe':'a '~field)|ui }}.{% endif %}</small>{% endif %}</label>
{% if kind=='sale' and field in ['customer','supplier'] %}<label data-new-account="{{ field }}">{{ (field=='customer'?'New client name':'New supplier name')|ui }}<input name="new_{{ field }}" maxlength="200" value="{{ f['new_'~field]|default('') }}"></label>{% endif %}
