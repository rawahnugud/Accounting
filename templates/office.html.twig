{% extends 'layout.html.twig' %}
{% set groups={
 'Sales and tickets':{'sale':'Record a sale','reissue':'Record a ticket reissue','refund':'Issue a customer credit'},
 'Money in and out':{'receipt':'Receive a customer payment','supplier_payment':'Pay a supplier','transfer':'Transfer between accounts','fee':'Record a fee or expense','customer_refund':'Pay a customer refund','supplier_refund':'Receive a supplier refund'},
 'Staff and creditors':{'payroll':'Record salary owed','salary_payment':'Pay a salary','advance':'Give a staff advance','recovery':'Deduct an advance from salary','liability':'Record money owed to a creditor','repayment':'Repay a creditor'},
 'Balances and corrections':{'opening':'Enter an opening bank or safe balance','opening_party':'Enter an opening customer or supplier balance','deposit':'Record an owner contribution','withdrawal':'Record an owner withdrawal','reverse':'Reverse a document'}
} %}
{% set tasks={} %}{% for group in groups %}{% set tasks=tasks|merge(group) %}{% endfor %}
{% set kind=f.kind|default(app.request.query.get('task','')) %}
{% set chosen=tasks[kind]|default('') %}
{% set statement=section=='report' and app.request.query.get('view')=='statement' and not doc %}
{% set title=section=='dashboard'?info.name~' dashboard':(section=='post'?(preview?'Review transaction':(chosen?:'Choose a task')):(doc?'Document D-'~doc.id:(statement?'Find a statement':'Ledger and statements'))) %}
{% block content %}
<p class="context">{{ info.company }} <span>{{ info.base }}</span> <span>{{ info.role|capitalize }}</span></p>
<nav class="tabs" aria-label="Branch navigation">{% for page,label in {'dashboard':'Dashboard','post':'Record transaction','report':'Ledger and statements','statements':'Management reports'} %}{% if page!='post' or info.role!='viewer' %}<a href="{{ path('office',{branch:branch,section:page}) }}" {% if section==page %}aria-current="page"{% endif %}>{{ label }}</a>{% endif %}{% endfor %}</nav>
{% if section=='dashboard' %}
<h2>What do you need to do?</h2>
<div class="task-links">{% if info.role!='viewer' %}{% for k in ['sale','receipt','supplier_payment'] %}<a href="{{ path('office',{branch:branch,section:'post',task:k}) }}">{{ tasks[k] }}</a>{% endfor %}{% endif %}<a href="{{ path('office',{branch:branch,section:'report',view:'statement'}) }}">Find a statement</a></div>
{% if info.role=='admin' and not cash %}<p class="setup-note">To record money coming in or going out, <a href="{{ path('control',{setup:'cash',branch:branch}) }}#setup-cash">add this branch’s first bank or safe</a>.</p>{% endif %}
<h2>Branch balances and results</h2>
<div class="grid metrics">{% for label,value in metrics %}<div class="card"><a href="{{ path('office',{branch:branch,section:label in ['Gross profit','Net profit','Sales','Supplier costs']?'statements':'report'}) }}">{{ label }}</a><strong>{{ value }} <small>{{ info.base }}</small></strong></div>{% endfor %}</div>
{% elseif section=='post' %}
{% include 'transaction.html.twig' %}
{% else %}
{% if statement %}
<form method="get" class="card"><input type="hidden" name="view" value="statement">
<div class="grid"><label>Whose statement do you need?<select name="account" required><option value="">Choose a customer or supplier</option>{% for p in parties %}{% if p.kind in ['customer','supplier'] %}{% set id=p.kind~':'~p.id %}<option value="{{ id }}" {{ app.request.query.get('account')==id?'selected' }}>{{ p.name }} · {{ p.kind }} · {{ p.currency }}</option>{% endif %}{% endfor %}</select></label>
<label>From (optional)<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>Through (optional)<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label></div><button>Show statement</button></form>
{% if app.request.query.get('account') %}<h2>{{ names[app.request.query.get('account')]|default('Account statement') }}</h2>{% endif %}
{% elseif doc %}{% if doc.label %}<h2>{{ doc.label }}</h2>{% endif %}<p>{{ doc.address }} {{ doc.contact }} {{ doc.registration }}</p><p>{{ types[doc.kind]|default(doc.kind) }} · {{ doc.reference }} · {{ doc.day }} · {{ doc.staff }}</p>{% for k,v in doc.details %}{% if v is not empty %}<span>{{ k|replace({'_':' '})|capitalize }}: {{ v }} &nbsp;</span>{% endif %}{% endfor %}
{% else %}<form method="get" class="card"><div class="grid"><label>From<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>Through<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<label>Account or statement<select name="account"><option value="">All accounts</option>{% for k,n in names %}<option value="{{ k }}" {{ app.request.query.get('account')==k?'selected' }}>{{ n }}</option>{% endfor %}</select></label>
<label>Ticket, PNR, airline, service or reference<input name="search" value="{{ app.request.query.get('search') }}"></label><label>Staff<select name="user"><option value="">All staff</option>{% for s in staff %}<option value="{{ s.id }}" {{ app.request.query.get('user')==s.id?'selected' }}>{{ s.name }}</option>{% endfor %}</select></label></div><button>Apply filters</button></form>{% endif %}
{% if not statement or app.request.query.get('account') %}<div class="actions"><button onclick="window.print()">Print / save PDF</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export'})) }}">Download CSV</a> <a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook'})) }}">Excel workbook</a></div>
<h2>Account totals</h2><div class="scroll"><table><tr><th>Account</th><th>Currency</th><th>Net debit / (credit)</th><th>{{ info.base }}</th></tr>{% for t in totals %}<tr><td>{{ names[t.account]|default(t.account) }}</td><td>{{ t.currency }}</td><td>{{ t.amount }}</td><td>{{ t.report }}</td></tr>{% endfor %}</table></div>
{% endif %}{% endif %}
{% if section!='post' and (not statement or app.request.query.get('account')) %}<h2>{{ section=='dashboard'?'Recent entries':(statement?'Account activity':'Journal entries') }}</h2><div class="scroll"><table><tr><th>Date</th><th>Document</th><th>Reference</th><th>Account</th><th>Movement</th><th>{{ info.base }}</th></tr>{% for l in (section=='dashboard'?lines|slice(0,12):lines) %}<tr><td>{{ l.day }}</td><td><a href="{{ path('office',{branch:branch,section:'report',number:l.number,doc:l.number starts with 'D-'?l.number|slice(2):''}) }}">{{ l.number }}</a></td><td>{{ l.reference }}</td><td>{{ l.name }}</td><td>{{ l.amount }} {{ l.currency }}</td><td>{{ l.report }}</td></tr>{% else %}<tr><td colspan="6">No posted entries.</td></tr>{% endfor %}</table></div>{% endif %}
{% if section=='dashboard' %}<h2>Outstanding documents</h2><div class="scroll"><table><tr><th>Due</th><th>Document</th><th>Account</th><th>Outstanding</th></tr>{% for o in aging %}<tr><td>{{ o.due }} {{ o.due<today?' · Overdue' }}</td><td><a href="{{ path('office',{branch:branch,section:'report',doc:o.id}) }}">D-{{ o.id }}</a></td><td>{{ names[o.account] }}</td><td>{{ o.amount }} {{ o.currency }}</td></tr>{% else %}<tr><td colspan="4">No outstanding documents.</td></tr>{% endfor %}</table></div>
{% if info.role=='admin' and aging %}<details><summary>Match open items</summary><form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="request_key" value="{{ key }}"><label>Account<select name="account">{% for p in parties %}<option value="{{ p.kind }}:{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label>{% for side in ['debit','credit'] %}<label>Open {{ side }}<select name="{{ side }}">{% for o in aging %}{% if (side=='debit' and o.outstanding_minor>0) or (side=='credit' and o.outstanding_minor<0) %}<option value="{{ o.id }}">D-{{ o.id }} · {{ names[o.account] }} · {{ o.amount }} {{ o.currency }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label>Amount in account currency<input name="amount" required></label><button>Match items</button></form></details>{% endif %}
{% if matches %}<details><summary>Existing allocations</summary>{% for m in matches %}<form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}{{ names[m.account] }} · D-{{ m.debit_doc }} / D-{{ m.credit_doc }} <button name="remove" value="{{ m.id }}">Remove allocation</button></form>{% endfor %}</details>{% endif %}
{% if pending %}<h2>Awaiting approval</h2>{% for r in pending %}<details><summary>{{ r.name }} · {{ types[r.values.kind] }} · {{ r.values.reference }}</summary><dl>{% for k,v in r.values %}{% if v and k!='request_key' %}<dt>{{ k|capitalize }}</dt><dd>{{ names[k~':'~v]|default(v) }}</dd>{% endif %}{% endfor %}</dl><form action="{{ path('decision',{branch:branch,id:r.id}) }}" method="post">{{ include('csrf.html.twig') }}<button name="state" value="approved">Approve and post</button> <button name="state" value="declined">Decline</button></form></details>{% endfor %}{% endif %}
{% if checks %}<h2>Supplier reconciliation</h2>{% for c in checks %}<p>{{ c.day }} · {{ c.name }} · Difference {{ c.variance }} {{ c.currency }}</p>{% endfor %}{% endif %}
{% if schedule %}<h2>Scheduled repayments</h2>{% for s in schedule %}<p>{{ s.due }} · {{ s.name }} · D-{{ s.document_id }} · {{ s.amount }} {{ s.currency }}</p>{% endfor %}{% endif %}
{% if recs %}<h2>Bank reconciliation</h2>{% for r in recs %}<p>{{ r.day }} · {{ r.name }} · Difference {{ r.variance }} {{ r.currency }}</p>{% endfor %}{% endif %}{% endif %}
{% endblock %}
