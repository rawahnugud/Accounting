{% extends 'layout.html.twig' %}
{% set groups={
 'Sales and tickets':{'sale':'Record a sale','reissue':'Record a ticket reissue','refund':'Issue a customer credit'},
 'Money in and out':{'receipt':'Receive a customer payment','supplier_payment':'Pay a supplier','transfer':'Transfer between accounts','fee':'Record a fee or expense','customer_refund':'Pay a customer refund','supplier_refund':'Receive a supplier refund'},
 'Staff and creditors':{'payroll':'Record salary owed','salary_payment':'Pay a salary','advance':'Give a staff advance','recovery':'Deduct an advance from salary','liability':'Record money owed to a creditor','repayment':'Repay a creditor'},
 'Balances and corrections':{'opening':'Enter an opening bank or safe balance','opening_party':'Enter an opening customer or supplier balance','deposit':'Record an owner contribution','withdrawal':'Record an owner withdrawal','reverse':'Reverse a document'}
} %}
{% set tasks={} %}{% for group in groups %}{% set tasks=tasks|merge(group) %}{% endfor %}
{% set kind=f.kind|default(app.request.query.get('task','')) %}
{% set chosen=tasks[kind]|default('') %}
{% set statement=section=='report' and app.request.query.get('view')=='statement' and not doc %}
{% set title=section=='dashboard'?('Dashboard'|ui)~' · '~info.name:(section=='post'?(preview?'Review transaction':(chosen?:'Choose a task')):(doc?('Document'|ui)~' D-'~doc.id:(statement?'Find a statement':'Ledger and statements'))) %}
{% block content %}
<p class="context">{{ info.company }} <span><bdi>{{ info.base }}</bdi></span> <span>{{ (info.role|capitalize)|ui }}</span></p>
{% if section=='dashboard' %}
<h2>{{ 'What do you need to do?'|ui }}</h2>
<div class="task-links">{% if info.role!='viewer' %}{% for k in ['sale','receipt','supplier_payment'] %}<a href="{{ path('office',{branch:branch,section:'post',task:k}) }}">{{ (tasks[k])|ui }}</a>{% endfor %}{% endif %}<a href="{{ path('office',{branch:branch,section:'report',view:'statement'}) }}">{{ 'Find a statement'|ui }}</a></div>
{% if info.role=='admin' and not cash %}<p class="setup-note">{{ 'To record money coming in or going out,'|ui }} <a href="{{ path('control',{setup:'cash',branch:branch}) }}#setup-cash">{{ 'add this branch’s first bank or safe'|ui }}</a>.</p>{% endif %}
<h2>{{ 'Branch balances and results'|ui }}</h2>
<div class="grid metrics">{% for label,value in metrics %}<div class="card"><a href="{{ path('office',{branch:branch,section:label in ['Gross profit','Net profit','Sales','Supplier costs']?'statements':'report'}) }}">{{ (label)|ui }}</a><strong>{{ value }} <small><bdi>{{ info.base }}</bdi></small></strong></div>{% endfor %}</div>
{% elseif section=='post' %}
{% include 'transaction.html.twig' %}
{% else %}
{% if statement %}
<form method="get" class="card"><input type="hidden" name="view" value="statement">
<div class="grid"><label>{{ 'Whose statement do you need?'|ui }}<select name="account" required><option value="">{{ 'Choose a customer or supplier'|ui }}</option>{% for p in parties %}{% if p.kind in ['customer','supplier'] %}{% set id=p.kind~':'~p.id %}<option value="{{ id }}" {{ app.request.query.get('account')==id?'selected' }}>{{ p.name }} · {{ (p.kind)|ui }} · {{ p.currency }}</option>{% endif %}{% endfor %}</select></label>
<label>{{ 'From (optional)'|ui }}<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>{{ 'Through (optional)'|ui }}<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label></div><button>{{ 'Show statement'|ui }}</button></form>
{% if app.request.query.get('account') %}<h2>{{ names[app.request.query.get('account')]|default('Account statement') }}</h2>{% endif %}
{% elseif doc %}{% if doc.label %}<h2>{{ doc.label }}</h2>{% endif %}<p>{{ doc.address }} {{ doc.contact }} {{ doc.registration }}</p><p>{{ (types[doc.kind]|default(doc.kind))|ui }} · {{ doc.reference }} · {{ doc.day }} · {{ doc.staff }}</p>{% for k,v in doc.details %}{% if v is not empty %}<span>{{ (k|replace({'_':' '})|capitalize)|ui }}: {{ v }} &nbsp;</span>{% endif %}{% endfor %}
{% else %}<form method="get" class="card"><div class="grid"><label>{{ 'From'|ui }}<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>{{ 'Through'|ui }}<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<label>{{ 'Account or statement'|ui }}<select name="account"><option value="">{{ 'All accounts'|ui }}</option>{% for k,n in names %}<option value="{{ k }}" {{ app.request.query.get('account')==k?'selected' }}>{{ n }}</option>{% endfor %}</select></label>
<label>{{ 'Ticket, PNR, airline, service or reference'|ui }}<input name="search" value="{{ app.request.query.get('search') }}"></label><label>{{ 'Staff'|ui }}<select name="user"><option value="">{{ 'All staff'|ui }}</option>{% for s in staff %}<option value="{{ s.id }}" {{ app.request.query.get('user')==s.id?'selected' }}>{{ s.name }}</option>{% endfor %}</select></label></div><button>{{ 'Apply filters'|ui }}</button></form>{% endif %}
{% if not statement or app.request.query.get('account') %}<div class="actions"><button onclick="window.print()">{{ 'Print / save PDF'|ui }}</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export'})) }}">{{ 'Download CSV'|ui }}</a> <a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook'})) }}">{{ 'Excel workbook'|ui }}</a></div>
<h2>{{ 'Account totals'|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Currency'|ui }}</th><th>{{ 'Net debit / (credit)'|ui }}</th><th><bdi>{{ info.base }}</bdi></th></tr>{% for t in totals %}<tr><td>{{ names[t.account]|default(t.account) }}</td><td>{{ t.currency }}</td><td><bdi>{{ t.amount }}</bdi></td><td><bdi>{{ t.report }}</bdi></td></tr>{% endfor %}</table></div>
{% endif %}{% endif %}
{% if section!='post' and (not statement or app.request.query.get('account')) %}<h2>{{ (section=='dashboard'?'Recent entries':(statement?'Account activity':'Journal entries'))|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Date'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Reference'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Movement'|ui }}</th><th><bdi>{{ info.base }}</bdi></th></tr>{% for l in (section=='dashboard'?lines|slice(0,12):lines) %}<tr><td>{{ l.day }}</td><td><a href="{{ path('office',{branch:branch,section:'report',number:l.number,doc:l.number starts with 'D-'?l.number|slice(2):''}) }}"><bdi>{{ l.number }}</bdi></a></td><td>{{ l.reference }}</td><td>{{ l.name }}</td><td><bdi>{{ l.amount }}</bdi> {{ l.currency }}</td><td><bdi>{{ l.report }}</bdi></td></tr>{% else %}<tr><td colspan="6">{{ 'No posted entries.'|ui }}</td></tr>{% endfor %}</table></div>{% endif %}
{% if section=='dashboard' %}<h2>{{ 'Outstanding documents'|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Due'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Outstanding'|ui }}</th></tr>{% for o in aging %}<tr><td>{{ o.due }} {{ (o.due<today?' · Overdue')|ui }}</td><td><a href="{{ path('office',{branch:branch,section:'report',doc:o.id}) }}">D-{{ o.id }}</a></td><td>{{ names[o.account] }}</td><td><bdi>{{ o.amount }}</bdi> {{ o.currency }}</td></tr>{% else %}<tr><td colspan="4">{{ 'No outstanding documents.'|ui }}</td></tr>{% endfor %}</table></div>
{% if info.role=='admin' and aging %}<details><summary>{{ 'Match open items'|ui }}</summary><form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="request_key" value="{{ key }}"><label>{{ 'Account'|ui }}<select name="account">{% for p in parties %}<option value="{{ p.kind }}:{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label>{% for side in ['debit','credit'] %}<label>{{ 'Open'|ui }} {{ (side)|ui }}<select name="{{ side }}">{% for o in aging %}{% if (side=='debit' and o.outstanding_minor>0) or (side=='credit' and o.outstanding_minor<0) %}<option value="{{ o.id }}">D-{{ o.id }} · {{ names[o.account] }} · {{ o.amount }} {{ o.currency }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label>{{ 'Amount in account currency'|ui }}<input name="amount" required></label><button>{{ 'Match items'|ui }}</button></form></details>{% endif %}
{% if matches %}<details><summary>{{ 'Existing allocations'|ui }}</summary>{% for m in matches %}<form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}{{ names[m.account] }} · D-{{ m.debit_doc }} / D-{{ m.credit_doc }} <button name="remove" value="{{ m.id }}">{{ 'Remove allocation'|ui }}</button></form>{% endfor %}</details>{% endif %}
{% if pending %}<h2>{{ 'Awaiting approval'|ui }}</h2>{% for r in pending %}<details><summary>{{ r.name }} · {{ (types[r.values.kind])|ui }} · {{ r.values.reference }}</summary><dl>{% for k,v in r.values %}{% if v and k!='request_key' %}<dt>{{ (k|capitalize)|ui }}</dt><dd>{{ names[k~':'~v]|default(v) }}</dd>{% endif %}{% endfor %}</dl><form action="{{ path('decision',{branch:branch,id:r.id}) }}" method="post">{{ include('csrf.html.twig') }}<button name="state" value="approved">{{ 'Approve and post'|ui }}</button> <button name="state" value="declined">{{ 'Decline'|ui }}</button></form></details>{% endfor %}{% endif %}
{% if checks %}<h2>{{ 'Supplier reconciliation'|ui }}</h2>{% for c in checks %}<p>{{ c.day }} · {{ c.name }} {{ '· Difference'|ui }} {{ c.variance }} {{ c.currency }}</p>{% endfor %}{% endif %}
{% if schedule %}<h2>{{ 'Scheduled repayments'|ui }}</h2>{% for s in schedule %}<p>{{ s.due }} · {{ s.name }} · D-{{ s.document_id }} · {{ s.amount }} {{ s.currency }}</p>{% endfor %}{% endif %}
{% if recs %}<h2>{{ 'Bank reconciliation'|ui }}</h2>{% for r in recs %}<p>{{ r.day }} · {{ r.name }} {{ '· Difference'|ui }} {{ r.variance }} <bdi>{{ r.currency }}</bdi></p>{% endfor %}{% endif %}{% endif %}
{% endblock %}
