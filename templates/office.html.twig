{% extends 'layout.html.twig' %}
{% set title=section=='dashboard'?info.name~' dashboard':(section=='post'?'Record a transaction':(doc?'Document D-'~doc.id:'Ledger and statements')) %}
{% block content %}
<p>{{ info.company }} · {{ info.name }} · {{ info.base }} · {{ info.role }}</p>
<nav>{% for page,label in {'dashboard':'Dashboard','post':'Record transaction','report':'Ledger and statements','statements':'Management reports'} %}{% if page!='post' or info.role!='viewer' %}<a href="{{ path('office',{branch:branch,section:page}) }}">{{ label }}</a>{% endif %}{% endfor %}</nav>
{% if section=='dashboard' %}
<div class="grid">{% for label,value in metrics %}<div class="card"><a href="{{ path('office',{branch:branch,section:label in ['Gross profit','Net profit','Sales','Supplier costs']?'statements':'report'}) }}">{{ label }}</a><strong>{{ value }} {{ info.base }}</strong></div>{% endfor %}</div>
{% elseif section=='post' %}
{% if preview %}<h2>Posting preview</h2><table><tr><th>Account</th><th>Account movement</th><th>{{ info.base }} movement</th></tr>{% for e in preview %}<tr><td>{{ names[e.account]|default(e.account) }}</td><td>{{ e.native }} {{ e.currency }}</td><td>{{ e.base }}</td></tr>{% endfor %}</table>
<form method="post">{{ include('csrf.html.twig') }}{% for k,v in f %}{% if k not in ['_token','mode'] %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endif %}{% endfor %}<button name="mode" value="confirm">Confirm posting</button></form>{% endif %}
<form method="post" class="card">{{ include('csrf.html.twig') }}<input type="hidden" name="request_key" value="{{ f.request_key|default(key) }}">
<div class="grid"><label>Operation<select id="operation" name="kind">{% for k,label in types %}{% if info.role=='admin' or k not in ['opening','opening_party','reverse','deposit','withdrawal','payroll','advance','recovery','salary_payment','liability'] %}<option value="{{ k }}" {{ f.kind|default('sale')==k?'selected' }}>{{ label }}</option>{% else %}<option value="{{ k }}">{{ label }} · approval required</option>{% endif %}{% endfor %}</select></label>
<label>Posting date<input type="date" name="day" value="{{ f.day|default(today) }}" required></label>
<label>Reference<input name="reference" maxlength="160" value="{{ f.reference|default('') }}" required></label>
<label>Due date<input type="date" name="due" value="{{ f.due|default('') }}"></label>
{% for kind in ['customer','supplier','employee','creditor'] %}<label data-field="{{ kind }}">{{ kind|capitalize }}<select name="{{ kind }}"><option value="">Select</option>{% for p in parties %}{% if p.kind==kind %}<option value="{{ p.id }}" {{ f[kind]|default('')==p.id?'selected' }}>{{ p.name }} · {{ p.currency }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}
{% for k,label in {'cash':'Bank or safe','destination':'Destination account'} %}<label data-field="{{ k }}">{{ label }}<select name="{{ k }}"><option value="">Select</option>{% for a in cash %}<option value="{{ a.id }}" {{ f[k]|default('')==a.id?'selected' }}>{{ a.name }} · {{ a.currency }}</option>{% endfor %}</select></label>{% endfor %}
{% for k,label in {'amount':'Amount (in cash account currency for cash movements)','converted':'Converted sale amount (optional)','override':'Override source rate (admin)','allowance':'Payroll allowances','deduction':'Payroll deductions','cost':'Supplier cost','related':'Original document number (digits only)','service':'Service category','passenger':'Passenger','pnr':'PNR','ticket':'Ticket number','airline':'Airline','route':'Route','note':'Notes'} %}<label data-field="{{ k }}">{{ label }}<input name="{{ k }}" {% if k=='service' %}list="categories"{% endif %} value="{{ f[k]|default('') }}"></label>{% endfor %}
{% for k,label in {'currency':'Source currency','cost_currency':'Supplier cost currency'} %}<label data-field="{{ k }}">{{ label }}<select name="{{ k }}">{% for code,n in prec %}<option {{ f[k]|default(info.base)==code?'selected' }}>{{ code }}</option>{% endfor %}</select></label>{% endfor %}
<datalist id="categories">{% for s in services %}<option value="{{ s.name }}">{% endfor %}</datalist></div><button name="mode" value="preview">Preview posting</button> <button name="mode" value="request">Submit for approval</button></form>
<script>
const fields={opening_party:'customer supplier amount currency',sale:'customer supplier amount currency converted override cost cost_currency service passenger pnr ticket airline route',reissue:'customer supplier amount currency converted override cost cost_currency service passenger pnr ticket airline route related',refund:'customer supplier amount currency converted override cost cost_currency service passenger pnr ticket airline route related',receipt:'customer cash amount related',customer_refund:'customer cash amount related',supplier_payment:'supplier cash amount related',supplier_refund:'supplier cash amount related',liability:'creditor amount currency',repayment:'creditor cash amount related',payroll:'employee amount currency allowance deduction',salary_payment:'employee cash amount related',advance:'employee cash amount',recovery:'employee amount currency',transfer:'cash destination amount',reverse:'related'};
function showFields(){const used=(fields[document.querySelector('#operation').value]||'cash amount').split(' ').concat('note');document.querySelectorAll('[data-field]').forEach(el=>{el.hidden=!used.includes(el.dataset.field);el.querySelector('input,select').disabled=el.hidden;});}
document.querySelector('#operation').addEventListener('change',showFields);showFields();
</script>
{% else %}
{% if doc %}{% if doc.label %}<h2>{{ doc.label }}</h2>{% endif %}<p>{{ doc.address }} {{ doc.contact }} {{ doc.registration }}</p><p>{{ types[doc.kind]|default(doc.kind) }} · {{ doc.reference }} · {{ doc.day }} · {{ doc.staff }}</p>{% for k,v in doc.details %}{% if v is not empty %}<span>{{ k|replace({'_':' '})|capitalize }}: {{ v }} &nbsp;</span>{% endif %}{% endfor %}
{% else %}<form method="get" class="card"><div class="grid"><label>From<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>Through<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<label>Account or statement<select name="account"><option value="">All accounts</option>{% for k,n in names %}<option value="{{ k }}" {{ app.request.query.get('account')==k?'selected' }}>{{ n }}</option>{% endfor %}</select></label>
<label>Ticket, PNR, airline, service or reference<input name="search" value="{{ app.request.query.get('search') }}"></label><label>Staff<select name="user"><option value="">All staff</option>{% for s in staff %}<option value="{{ s.id }}" {{ app.request.query.get('user')==s.id?'selected' }}>{{ s.name }}</option>{% endfor %}</select></label></div><button>Apply filters</button></form>{% endif %}
<div class="actions"><button onclick="window.print()">Print / save PDF</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export'})) }}">Download CSV</a> <a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook'})) }}">Excel workbook</a></div>
<h2>Account totals</h2><div class="scroll"><table><tr><th>Account</th><th>Currency</th><th>Net debit / (credit)</th><th>{{ info.base }}</th></tr>{% for t in totals %}<tr><td>{{ names[t.account]|default(t.account) }}</td><td>{{ t.currency }}</td><td>{{ t.amount }}</td><td>{{ t.report }}</td></tr>{% endfor %}</table></div>
{% endif %}
{% if section!='post' %}<h2>{{ section=='dashboard'?'Recent entries':'Journal entries' }}</h2><div class="scroll"><table><tr><th>Date</th><th>Document</th><th>Reference</th><th>Account</th><th>Movement</th><th>{{ info.base }}</th></tr>{% for l in (section=='dashboard'?lines|slice(0,12):lines) %}<tr><td>{{ l.day }}</td><td><a href="{{ path('office',{branch:branch,section:'report',number:l.number,doc:l.number starts with 'D-'?l.number|slice(2):''}) }}">{{ l.number }}</a></td><td>{{ l.reference }}</td><td>{{ l.name }}</td><td>{{ l.amount }} {{ l.currency }}</td><td>{{ l.report }}</td></tr>{% else %}<tr><td colspan="6">No posted entries.</td></tr>{% endfor %}</table></div>{% endif %}
{% if section=='dashboard' %}<h2>Outstanding documents</h2><div class="scroll"><table><tr><th>Due</th><th>Document</th><th>Account</th><th>Outstanding</th></tr>{% for o in aging %}<tr><td>{{ o.due }} {{ o.due<today?' · Overdue' }}</td><td><a href="{{ path('office',{branch:branch,section:'report',doc:o.id}) }}">D-{{ o.id }}</a></td><td>{{ names[o.account] }}</td><td>{{ o.amount }} {{ o.currency }}</td></tr>{% else %}<tr><td colspan="4">No outstanding documents.</td></tr>{% endfor %}</table></div>
{% if info.role=='admin' and aging %}<details><summary>Match open items</summary><form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="request_key" value="{{ key }}"><label>Account<select name="account">{% for p in parties %}<option value="{{ p.kind }}:{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label>{% for side in ['debit','credit'] %}<label>Open {{ side }}<select name="{{ side }}">{% for o in aging %}{% if (side=='debit' and o.outstanding_minor>0) or (side=='credit' and o.outstanding_minor<0) %}<option value="{{ o.id }}">D-{{ o.id }} · {{ names[o.account] }} · {{ o.amount }} {{ o.currency }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label>Amount in account currency<input name="amount" required></label><button>Match items</button></form></details>{% endif %}
{% if matches %}<details><summary>Existing allocations</summary>{% for m in matches %}<form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}{{ names[m.account] }} · D-{{ m.debit_doc }} / D-{{ m.credit_doc }} <button name="remove" value="{{ m.id }}">Remove allocation</button></form>{% endfor %}</details>{% endif %}
{% if pending %}<h2>Awaiting approval</h2>{% for r in pending %}<details><summary>{{ r.name }} · {{ types[r.values.kind] }} · {{ r.values.reference }}</summary><dl>{% for k,v in r.values %}{% if v and k!='request_key' %}<dt>{{ k|capitalize }}</dt><dd>{{ names[k~':'~v]|default(v) }}</dd>{% endif %}{% endfor %}</dl><form action="{{ path('decision',{branch:branch,id:r.id}) }}" method="post">{{ include('csrf.html.twig') }}<button name="state" value="approved">Approve and post</button> <button name="state" value="declined">Decline</button></form></details>{% endfor %}{% endif %}
{% if checks %}<h2>Supplier reconciliation</h2>{% for c in checks %}<p>{{ c.day }} · {{ c.name }} · Difference {{ c.variance }} {{ c.currency }}</p>{% endfor %}{% endif %}
{% if schedule %}<h2>Scheduled repayments</h2>{% for s in schedule %}<p>{{ s.due }} · {{ s.name }} · D-{{ s.document_id }} · {{ s.amount }} {{ s.currency }}</p>{% endfor %}{% endif %}
{% if recs %}<h2>Bank reconciliation</h2>{% for r in recs %}<p>{{ r.day }} · {{ r.name }} · Difference {{ r.variance }} {{ r.currency }}</p>{% endfor %}{% endif %}{% endif %}
{% endblock %}
