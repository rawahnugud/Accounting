{% extends 'layout.html.twig' %}
{% set groups={
 'Sales and tickets':{'sale':'Record a sale','reissue':'Record a ticket reissue','refund':'Issue a customer credit'},
 'Money in and out':{'receipt':'Receive a customer payment','supplier_payment':'Pay a supplier','transfer':'Transfer between accounts','fee':'Record a fee or expense','customer_refund':'Pay a customer refund','supplier_refund':'Receive a supplier refund'},
 'Staff and creditors':{'payroll':'Record salary owed','salary_payment':'Pay a salary','advance':'Give a staff advance','recovery':'Deduct an advance from salary','liability':'Record money owed to a creditor','loan':'Receive a loan from a creditor','repayment':'Repay a creditor'},
 'Balances and corrections':{'opening':'Enter an opening bank or safe balance','opening_party':'Enter an opening customer or supplier balance','deposit':'Record an owner contribution','withdrawal':'Record an owner withdrawal','reverse':'Reverse a document'}
} %}
{% set tasks={} %}{% for group in groups %}{% set tasks=tasks|merge(group) %}{% endfor %}
{% set kind=f.kind|default(app.request.query.get('task','')) %}
{% set chosen=tasks[kind]|default('') %}
{% set title=section=='dashboard'?'Dashboard':(section=='post'?(preview?'Review transaction':(chosen?:'Choose a task')):(doc?('Document'|ui)~' D-'~doc.id:'General ledger')) %}
{% block content %}
{% set here=app.request.pathInfo~(app.request.queryString?'?'~app.request.queryString:'') %}
<p class="context">{{ info.company }} <span>{{ info.view }}</span></p>
{% if section=='dashboard' %}

<div class="task-links daily">{% if info.role!='viewer' %}{% for k in ['sale','receipt','supplier_payment'] %}<a href="{{ path('task',{branch:branch,task:k|replace({'_':'-'})}) }}">{{ (tasks[k])|ui }}</a>{% endfor %}{% endif %}<a href="{{ path('office',{branch:branch,section:'statement'}) }}">{{ 'Find a statement'|ui }}</a></div>
{% if pending %}<section class="unfinished"><h2>{{ 'Unfinished entries'|ui }}</h2>
{% for r in pending %}<div class="actions"><a href="{{ path('office',{branch:branch,section:'new',draft:r.id}) }}">{{ (types[r.values.kind]|default(r.values.kind))|ui }} · {{ r.values.reference }} · {{ r.values.amount|default('') }} {{ r.values.currency|default('') }} — {{ 'Continue entry'|ui }}</a> <form method="post" action="{{ path('office',{branch:branch,section:'new'}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="draft" value="{{ r.id }}"><button class="secondary" name="mode" value="discard">{{ 'Discard'|ui }}</button></form></div>{% endfor %}</section>{% endif %}
{% if info.role=='admin' and not cash %}<p class="setup-note">{{ 'To record money coming in or going out,'|ui }} <a href="{{ path('control',{setup:'cash',branch:branch}) }}#setup-cash">{{ 'add this branch’s first bank or safe'|ui }}</a>.</p>{% endif %}
<h2>{{ 'Account balances'|ui }}</h2>
<div class="grid metrics">{% for label in ['Cash','Receivables','Supplier payables','Sales this month','Gross profit this month'] %}<div class="card"><a href="{{ path('office',label ends with 'this month'?{branch:branch,section:'reports',from:today|slice(0,8)~'01'}:{branch:branch,section:'reports'}) }}">{{ (label)|ui }}</a>{% if dual[label] is defined %}{% for c,v in dual[label] %}<strong class="dual-amount"><bdi>{{ v }}</bdi> <small><bdi>{{ c }}</bdi></small></strong>{% endfor %}<small>{{ 'Total in'|ui }} <bdi>{{ info.view }}</bdi>: <bdi>{{ metrics[label] }}</bdi></small>{% else %}<strong><bdi>{{ metrics[label] }}</bdi> <small><bdi>{{ info.view }}</bdi></small></strong>{% endif %}</div>{% endfor %}</div>
{% if banks %}<h2>{{ 'Bank and safe balances'|ui }}</h2>
<div class="scroll"><table><thead><tr><th>{{ 'Bank or safe'|ui }}</th><th>{{ 'Balance'|ui }}</th><th>{{ 'Value in'|ui }} <bdi>{{ info.view }}</bdi></th></tr></thead>
<tbody>{% for b in banks %}<tr><td><a href="{{ path('office',{branch:branch,section:'statement',account:'cash:'~b.id}) }}">{{ b.name }}</a></td><td><bdi>{{ b.balance }}</bdi> <bdi>{{ b.currency }}</bdi></td><td><bdi>{{ b.report }}</bdi></td></tr>{% endfor %}</tbody>
<tfoot>{% for c,v in dual['Cash']|default({}) %}{% if banks|filter(b=>b.currency==c) %}<tr><th>{{ 'Total'|ui }} <bdi>{{ c }}</bdi></th><th><bdi>{{ v }}</bdi> <bdi>{{ c }}</bdi></th><th></th></tr>{% endif %}{% endfor %}
<tr><th>{{ 'Total in'|ui }} <bdi>{{ info.view }}</bdi></th><th></th><th><bdi>{{ metrics['Cash'] }}</bdi></th></tr></tfoot></table></div>{% endif %}
<h2>{{ 'Recent sales'|ui }}</h2>
<div class="scroll"><table><thead><tr><th>{{ 'Document'|ui }}</th><th>{{ 'Customer'|ui }}</th><th>{{ 'Date'|ui }}</th><th>{{ 'Selling price'|ui }}</th><th>{{ 'Sales'|ui }} ({{ info.view }})</th><th>{{ 'Gross profit'|ui }} ({{ info.view }})</th>{% if info.role!='viewer' %}<th></th>{% endif %}</tr></thead>
<tbody>{% for sale in recentSales %}<tr><td><a href="{{ path('office',{branch:branch,section:'d',doc:sale.id}) }}">D-{{ sale.id }}</a> · {{ sale.reference }} {% if sale.reversed %}({{ 'Reversed'|ui }}){% endif %}</td><td>{{ sale.customer }}</td><td>{{ sale.day }}</td><td><bdi>{{ sale.price }}</bdi></td><td><bdi>{{ sale.total }}</bdi></td><td><bdi>{{ sale.margin }}</bdi></td>{% if info.role!='viewer' %}<td>{% if not sale.reversed %}<a href="{{ path('office',{branch:branch,section:'edit',doc:sale.id,back:here}) }}">{{ 'Edit'|ui }}</a> · <a href="{{ path('office',{branch:branch,section:'d',doc:sale.id,back:here}) }}#change">{{ 'Delete'|ui }}</a>{% endif %}</td>{% endif %}</tr>{% else %}<tr><td colspan="7">{{ 'Saved sales will appear here.'|ui }}</td></tr>{% endfor %}</tbody></table></div>
{% elseif section=='post' %}
{% include 'transaction.html.twig' %}
{% else %}
{% if doc %}{% set changeable=info.role!='viewer' and not doc.voided and not doc.reversal_of and doc.kind not in ['allocation_fx','revaluation'] %}
<div class="doc-toolbar no-print">{% if back %}<a class="doc-back" href="{{ app.request.basePath ~ back }}">{{ '← Back'|ui }}</a>{% endif %}{% if changeable %}{% if doc.import_amount is defined %}<button type="button" data-open="edit-dialog">{{ 'Edit'|ui }}</button>{% elseif doc.kind in types|keys %}<a class="button" href="{{ path('office',{branch:branch,section:'edit',doc:doc.id,back:back ?: here}) }}">{{ 'Edit'|ui }}</a>{% endif %}<button type="button" class="secondary" data-open="change">{{ 'Delete'|ui }}</button>{% endif %}
<button type="button" class="secondary" onclick="window.print()">{{ 'Print / save PDF'|ui }}</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export',back:null})) }}">{{ 'Download CSV'|ui }}</a><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook',back:null})) }}">{{ 'Excel workbook'|ui }}</a>{% if info.role!='viewer' and tasks[doc.kind] is defined and doc.kind!='reverse' %}<a href="{{ path('task',{branch:branch,task:doc.kind|replace({'_':'-'})}) }}">+ {{ tasks[doc.kind]|ui }}</a>{% endif %}</div>
<section class="card doc-card"><div class="doc-head"><div><small>{{ (types[doc.kind]|default(doc.kind))|ui }}</small><h2>{{ doc.label ?: 'D-'~doc.id }}</h2></div>{% if doc.voided %}<span class="role">{{ 'Deleted'|ui }}</span>{% endif %}</div>
<dl class="doc-details"><div><dt>{{ 'Date'|ui }}</dt><dd><bdi>{{ doc.day }}</bdi></dd></div>{% if doc.reference %}<div><dt>{{ 'Reference'|ui }}</dt><dd><bdi>{{ doc.reference }}</bdi></dd></div>{% endif %}<div><dt>{{ 'Recorded by'|ui }}</dt><dd>{{ doc.staff }}</dd></div>
{% for k,v in doc.details %}{% if v is not empty and (doc.kind not in ['sale','reissue','refund'] or k not in ['amount','source','cost','cost_currency']) and (k!='cost_currency' or doc.details.cost|default('') is not empty) and k not in ['override_by','override'] and (k not in ['source_rate','cost_rate'] or v!='1') %}<div><dt>{{ (k|replace({'_':' '})|capitalize)|ui }}</dt><dd><bdi>{{ v }}</bdi></dd></div>{% endif %}{% endfor %}</dl>
{% if doc.kind in ['sale','reissue','refund'] %}<div class="sale-summary"><div>{{ 'Selling price'|ui }}<strong><bdi>{{ doc.details.amount }} {{ doc.details.source }}</bdi></strong></div><div>{{ 'Supplier cost'|ui }}<strong><bdi>{{ doc.details.cost|default('0') }} {{ doc.details.cost_currency }}</bdi></strong></div></div>{% endif %}
{% if doc.address or doc.contact or doc.registration %}<small class="doc-company">{{ doc.address }} {{ doc.contact }} {{ doc.registration }}</small>{% endif %}</section>
{% if changeable %}<dialog id="change" class="confirm"><form method="post" action="{{ path('office',{branch:branch,section:'new'}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="amend" value="{{ doc.id }}"><input type="hidden" name="back" value="{{ back }}"><h2>{{ 'Delete this entry?'|ui }}</h2>
<label>{{ 'Reason for deleting'|ui }}<input name="reason" required></label><div class="actions"><button name="mode" value="void">{{ 'Delete entry'|ui }}</button><button type="button" class="secondary" data-close>{{ 'Cancel'|ui }}</button></div></form></dialog>
{% if doc.import_amount is defined %}<dialog id="edit-dialog" class="confirm"><form method="post" action="{{ path('office',{branch:branch,section:'new'}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="amend" value="{{ doc.id }}"><input type="hidden" name="back" value="{{ back }}"><h2>{{ 'Edit entry'|ui }}</h2>
<label>{{ 'Amount'|ui }} (USD)<input name="amount" inputmode="decimal" required value="{{ doc.import_amount }}"></label>
<label>{{ 'Reference'|ui }}<input name="reference" required value="{{ doc.reference }}"></label>
<label>{{ 'Ticket number'|ui }}<input name="ticket" value="{{ doc.details.ticket|default('') }}"></label>
<label>{{ 'Reason for correction'|ui }}<input name="reason" required></label><div class="actions"><button name="mode" value="save">{{ 'Amend document'|ui }}</button><button type="button" class="secondary" data-close>{{ 'Cancel'|ui }}</button></div></form></dialog>{% endif %}
<script>(()=>{const open=id=>{const d=document.getElementById(id);if(d&&d.showModal){d.showModal();d.querySelector('input:not([type=hidden])')?.focus()}};
document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>open(b.dataset.open)));
document.querySelectorAll('dialog [data-close]').forEach(b=>b.addEventListener('click',()=>b.closest('dialog').close()));
if(location.hash==='#change')open('change');})();</script>{% endif %}
{% else %}<form method="get" class="card"><div class="grid"><label>{{ 'From'|ui }}<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>{{ 'Through'|ui }}<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<label>{{ 'Account or statement'|ui }}<select name="account"><option value="">{{ 'All accounts'|ui }}</option>{% for k,n in names %}<option value="{{ k }}" {{ app.request.query.get('account')==k?'selected' }}>{{ n }}</option>{% endfor %}</select></label>
<label>{{ 'Ticket, PNR, airline, service or reference'|ui }}<input name="search" value="{{ app.request.query.get('search') }}"></label><label>{{ 'Staff'|ui }}<select name="user"><option value="">{{ 'All staff'|ui }}</option>{% for s in staff %}<option value="{{ s.id }}" {{ app.request.query.get('user')==s.id?'selected' }}>{{ s.name }}</option>{% endfor %}</select></label></div><button>{{ 'Apply filters'|ui }}</button></form><div class="actions"><button onclick="window.print()">{{ 'Print / save PDF'|ui }}</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export',back:null})) }}">{{ 'Download CSV'|ui }}</a> <a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook',back:null})) }}">{{ 'Excel workbook'|ui }}</a></div>{% endif %}
<h2>{{ 'Account totals'|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Currency'|ui }}</th><th>{{ 'Net debit / (credit)'|ui }}</th><th><bdi>{{ info.view }}</bdi></th></tr>{% for t in totals %}<tr><td>{{ names[t.account]|default(t.account) }}</td><td>{{ t.currency }}</td><td><bdi>{{ t.amount }}</bdi></td><td><bdi>{{ t.report }}</bdi></td></tr>{% endfor %}</table></div>
{% endif %}
{% if section=='report' %}<h2>{{ 'Journal entries'|ui }}</h2>{% if truncated %}<p class="setup-note">{{ 'Showing the latest 500 lines. Use the filters above, or download the CSV for every line.'|ui }}</p>{% endif %}<div class="scroll"><table><tr><th>{{ 'Date'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Reference'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Movement'|ui }}</th><th><bdi>{{ info.view }}</bdi></th>{% if info.role!='viewer' %}<th class="no-print"></th>{% endif %}</tr>{% for l in lines %}<tr><td>{{ l.day }}</td><td><a href="{{ l.number starts with 'D-' ? path('office',{branch:branch,section:'d',doc:l.number|slice(2)}) : path('office',{branch:branch,section:'ledger',number:l.number}) }}"><bdi>{{ l.number }}</bdi></a></td><td>{{ l.reference }}</td><td>{{ l.name }}</td><td><bdi>{{ l.shown }}</bdi> {{ l.currency }}</td><td><bdi>{{ l.shown_report }}</bdi></td>{% if info.role!='viewer' %}<td class="no-print">{% if l.number starts with 'D-' and l.kind not in ['reverse','allocation_fx','revaluation'] and (loop.first or lines[loop.index0-1].number!=l.number) %}<a href="{{ path('office',{branch:branch,section:'edit',doc:l.number|slice(2),back:here}) }}">{{ 'Edit'|ui }}</a> · <a href="{{ path('office',{branch:branch,section:'d',doc:l.number|slice(2),back:here}) }}#change">{{ 'Delete'|ui }}</a>{% endif %}</td>{% endif %}</tr>{% else %}<tr><td colspan="7">{{ 'No posted entries.'|ui }}</td></tr>{% endfor %}</table></div>{% endif %}
{% if section=='dashboard' %}{% if aging %}<details><summary>{{ 'Outstanding documents'|ui }} ({{ aging|length }})</summary><div class="scroll"><table><tr><th>{{ 'Due'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Outstanding'|ui }}</th></tr>{% for o in aging %}<tr><td>{{ o.due }} {{ (o.due<today?' · Overdue')|ui }}</td><td><a href="{{ path('office',{branch:branch,section:'d',doc:o.id}) }}">D-{{ o.id }}</a></td><td>{{ names[o.account] }}</td><td><bdi>{{ o.amount }}</bdi> {{ o.currency }}</td></tr>{% else %}<tr><td colspan="4">{{ 'No outstanding documents.'|ui }}</td></tr>{% endfor %}</table></div>
</details>{% endif %}



{% if schedule %}<h2>{{ 'Scheduled repayments'|ui }}</h2>{% for s in schedule %}<p>{{ s.due }} · {{ s.name }} · D-{{ s.document_id }} · {{ s.amount }} {{ s.currency }}</p>{% endfor %}{% endif %}
{% endif %}
{% endblock %}
