{% extends 'layout.html.twig' %}
{% set groups={
 'Sales and tickets':{'sale':'Record a sale','reissue':'Record a ticket reissue','refund':'Issue a customer credit'},
 'Money in and out':{'receipt':'Receive a customer payment','supplier_payment':'Pay a supplier','transfer':'Transfer between accounts','fee':'Record a fee or expense','customer_refund':'Pay a customer refund','supplier_refund':'Receive a supplier refund'},
 'Staff and creditors':{'payroll':'Record salary owed','salary_payment':'Pay a salary','advance':'Give a staff advance','recovery':'Deduct an advance from salary','liability':'Record money owed to a creditor','repayment':'Repay a creditor'},
 'Balances and corrections':{'opening':'Enter an opening bank or safe balance','opening_party':'Enter an opening customer or supplier balance','deposit':'Record an owner contribution','withdrawal':'Record an owner withdrawal','reverse':'Reverse a document'}
} %}
{% set tasks={} %}{% for group in groups %}{% set tasks=tasks|merge(group) %}{% endfor %}
{% set kind=f.kind|default(app.request.query.get('task','')) %}
{% set chosen=tasks[kind]|default('') %}
{% set title=section=='dashboard'?'Dashboard':(section=='post'?(preview?'Review transaction':(chosen?:'Choose a task')):(doc?('Document'|ui)~' D-'~doc.id:'General ledger')) %}
{% block content %}
<p class="context">{{ info.company }} <span>{{ info.base }}</span></p>
{% if section=='dashboard' %}

<div class="task-links daily">{% if info.role!='viewer' %}{% for k in ['sale','receipt','supplier_payment'] %}<a href="{{ path('office',{branch:branch,section:'post',task:k}) }}">{{ (tasks[k])|ui }}</a>{% endfor %}{% endif %}<a href="{{ path('office',{branch:branch,section:'report',view:'statement'}) }}">{{ 'Find a statement'|ui }}</a></div>
{% if pending %}<section class="unfinished"><h2>{{ 'Unfinished entries'|ui }}</h2>
{% for r in pending %}<p><a href="{{ path('office',{branch:branch,section:'post',draft:r.id}) }}">{{ (types[r.values.kind]|default(r.values.kind))|ui }} · {{ r.values.reference }} · {{ r.values.amount|default('') }} {{ r.values.currency|default('') }} — {{ 'Continue entry'|ui }}</a></p>{% endfor %}</section>{% endif %}
{% if info.role=='admin' and not cash %}<p class="setup-note">{{ 'To record money coming in or going out,'|ui }} <a href="{{ path('control',{setup:'cash',branch:branch}) }}#setup-cash">{{ 'add this branch’s first bank or safe'|ui }}</a>.</p>{% endif %}
<h2>{{ 'Account balances'|ui }}</h2>
<div class="grid metrics">{% for label,value in metrics|filter((value,label)=>label in ['Sales','Gross profit','Cash','Receivables']) %}<div class="card"><a href="{{ path('office',{branch:branch,section:label in ['Gross profit','Net profit','Sales','Supplier costs']?'statements':'report'}) }}">{{ (label)|ui }}</a><strong>{{ value }} <small><bdi>{{ info.base }}</bdi></small></strong></div>{% endfor %}</div>
<h2>{{ 'Recent sales'|ui }}</h2>
<div class="scroll"><table><thead><tr><th>{{ 'Document'|ui }}</th><th>{{ 'Customer'|ui }}</th><th>{{ 'Date'|ui }}</th><th>{{ 'Sales'|ui }} ({{ info.base }})</th><th>{{ 'Gross profit'|ui }} ({{ info.base }})</th></tr></thead>
<tbody>{% for sale in recentSales %}<tr><td><a href="{{ path('office',{branch:branch,section:'report',doc:sale.id}) }}">D-{{ sale.id }}</a> · {{ sale.reference }} {% if sale.reversed %}({{ 'Reversed'|ui }}){% endif %}</td><td>{{ sale.customer }}</td><td>{{ sale.day }}</td><td><bdi>{{ sale.total }}</bdi></td><td><bdi>{{ sale.margin }}</bdi></td></tr>{% else %}<tr><td colspan="5">{{ 'Saved sales will appear here.'|ui }}</td></tr>{% endfor %}</tbody></table></div>
{% elseif section=='post' %}
{% include 'transaction.html.twig' %}
{% else %}
{% if doc %}{% if info.role!='viewer' %}<div class="actions"><a href="{{ path('office',{branch:branch,section:'post',task:'sale'}) }}">{{ 'Record another sale'|ui }}</a></div>{% endif %}{% if doc.label %}<h2>{{ doc.label }}</h2>{% endif %}<p>{{ doc.address }} {{ doc.contact }} {{ doc.registration }}</p><p>{{ (types[doc.kind]|default(doc.kind))|ui }} · {{ doc.reference }} · {{ doc.day }} · {{ doc.staff }}</p>{% if doc.kind in ['sale','reissue','refund'] %}<div class="sale-summary"><div>{{ 'Selling price'|ui }}<strong><bdi>{{ doc.details.amount }} {{ doc.details.source }}</bdi></strong></div><div>{{ 'Supplier cost'|ui }}<strong><bdi>{{ doc.details.cost|default('0') }} {{ doc.details.cost_currency }}</bdi></strong></div></div>{% endif %}
{% for k,v in doc.details %}{% if v is not empty and (doc.kind not in ['sale','reissue','refund'] or k not in ['amount','source','cost','cost_currency']) %}<span>{{ (k|replace({'_':' '})|capitalize)|ui }}: {{ v }} &nbsp;</span>{% endif %}{% endfor %}
{% else %}<form method="get" class="card"><div class="grid"><label>{{ 'From'|ui }}<input type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>{{ 'Through'|ui }}<input type="date" name="to" value="{{ app.request.query.get('to') }}"></label>
<label>{{ 'Account or statement'|ui }}<select name="account"><option value="">{{ 'All accounts'|ui }}</option>{% for k,n in names %}<option value="{{ k }}" {{ app.request.query.get('account')==k?'selected' }}>{{ n }}</option>{% endfor %}</select></label>
<label>{{ 'Ticket, PNR, airline, service or reference'|ui }}<input name="search" value="{{ app.request.query.get('search') }}"></label><label>{{ 'Staff'|ui }}<select name="user"><option value="">{{ 'All staff'|ui }}</option>{% for s in staff %}<option value="{{ s.id }}" {{ app.request.query.get('user')==s.id?'selected' }}>{{ s.name }}</option>{% endfor %}</select></label></div><button>{{ 'Apply filters'|ui }}</button></form>{% endif %}
<div class="actions"><button onclick="window.print()">{{ 'Print / save PDF'|ui }}</button><a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'export'})) }}">{{ 'Download CSV'|ui }}</a> <a href="{{ path('office',app.request.query.all|merge({branch:branch,section:'workbook'})) }}">{{ 'Excel workbook'|ui }}</a></div>
<h2>{{ 'Account totals'|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Currency'|ui }}</th><th>{{ 'Net debit / (credit)'|ui }}</th><th><bdi>{{ info.base }}</bdi></th></tr>{% for t in totals %}<tr><td>{{ names[t.account]|default(t.account) }}</td><td>{{ t.currency }}</td><td><bdi>{{ t.amount }}</bdi></td><td><bdi>{{ t.report }}</bdi></td></tr>{% endfor %}</table></div>
{% endif %}
{% if section=='report' %}<h2>{{ 'Journal entries'|ui }}</h2><div class="scroll"><table><tr><th>{{ 'Date'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Reference'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Movement'|ui }}</th><th><bdi>{{ info.base }}</bdi></th></tr>{% for l in lines %}<tr><td>{{ l.day }}</td><td><a href="{{ path('office',{branch:branch,section:'report',number:l.number,doc:l.number starts with 'D-'?l.number|slice(2):''}) }}"><bdi>{{ l.number }}</bdi></a></td><td>{{ l.reference }}</td><td>{{ l.name }}</td><td><bdi>{{ l.amount }}</bdi> {{ l.currency }}</td><td><bdi>{{ l.report }}</bdi></td></tr>{% else %}<tr><td colspan="6">{{ 'No posted entries.'|ui }}</td></tr>{% endfor %}</table></div>{% endif %}
{% if section=='dashboard' %}{% if aging %}<details><summary>{{ 'Outstanding documents'|ui }} ({{ aging|length }})</summary><div class="scroll"><table><tr><th>{{ 'Due'|ui }}</th><th>{{ 'Document'|ui }}</th><th>{{ 'Account'|ui }}</th><th>{{ 'Outstanding'|ui }}</th></tr>{% for o in aging %}<tr><td>{{ o.due }} {{ (o.due<today?' · Overdue')|ui }}</td><td><a href="{{ path('office',{branch:branch,section:'report',doc:o.id}) }}">D-{{ o.id }}</a></td><td>{{ names[o.account] }}</td><td><bdi>{{ o.amount }}</bdi> {{ o.currency }}</td></tr>{% else %}<tr><td colspan="4">{{ 'No outstanding documents.'|ui }}</td></tr>{% endfor %}</table></div>
</details>{% endif %}
{% if info.role=='admin' and aging %}<details><summary>{{ 'Match open items'|ui }}</summary><form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}<input type="hidden" name="request_key" value="{{ key }}"><label>{{ 'Account'|ui }}<select name="account">{% for p in parties %}<option value="{{ p.kind }}:{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label>{% for side in ['debit','credit'] %}<label>{{ 'Open'|ui }} {{ (side)|ui }}<select name="{{ side }}">{% for o in aging %}{% if (side=='debit' and o.outstanding_minor>0) or (side=='credit' and o.outstanding_minor<0) %}<option value="{{ o.id }}">D-{{ o.id }} · {{ names[o.account] }} · {{ o.amount }} {{ o.currency }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label>{{ 'Amount in account currency'|ui }}<input name="amount" required></label><button>{{ 'Match items'|ui }}</button></form></details>{% endif %}
{% if matches %}<details><summary>{{ 'Existing allocations'|ui }}</summary>{% for m in matches %}<form method="post" action="{{ path('match_items',{branch:branch}) }}">{{ include('csrf.html.twig') }}{{ names[m.account] }} · D-{{ m.debit_doc }} / D-{{ m.credit_doc }} <button name="remove" value="{{ m.id }}">{{ 'Remove allocation'|ui }}</button></form>{% endfor %}</details>{% endif %}
{% if checks %}<details><summary>{{ 'Supplier reconciliation'|ui }}</summary>{% for c in checks %}<p>{{ c.day }} · {{ c.name }} {{ '· Difference'|ui }} {{ c.variance }} {{ c.currency }}</p>{% endfor %}</details>{% endif %}
{% if schedule %}<h2>{{ 'Scheduled repayments'|ui }}</h2>{% for s in schedule %}<p>{{ s.due }} · {{ s.name }} · D-{{ s.document_id }} · {{ s.amount }} {{ s.currency }}</p>{% endfor %}{% endif %}
{% if recs %}<details><summary>{{ 'Bank reconciliation'|ui }}</summary>{% for r in recs %}<p>{{ r.day }} · {{ r.name }} {{ '· Difference'|ui }} {{ r.variance }} <bdi>{{ r.currency }}</bdi></p>{% endfor %}</details>{% endif %}{% endif %}
{% endblock %}
