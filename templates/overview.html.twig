{% extends 'layout.html.twig' %}
{% set title='Group overview' %}
{% block content %}<div class="scroll"><table><tr><th>{{ 'Company and branch'|ui }}</th><th>{{ 'Reporting currency'|ui }}</th><th>{{ 'Cash'|ui }}</th><th>{{ 'Sales'|ui }}</th><th>{{ 'Net profit'|ui }}</th></tr>
{% for r in rows %}<tr><td><a href="{{ path('office',{branch:r.id,section:'dashboard'}) }}">{{ r.company }} · {{ r.name }}</a></td><td><bdi>{{ r.currency }}</bdi></td><td><bdi>{{ r.cash }}</bdi></td><td><bdi>{{ r.sales }}</bdi></td><td><bdi>{{ r.profit }}</bdi></td></tr>{% endfor %}
{% for currency,r in totals %}<tr><th>{{ 'Total'|ui }}</th><th>{{ currency }}</th><th><bdi>{{ r.cash }}</bdi></th><th><bdi>{{ r.sales }}</bdi></th><th><bdi>{{ r.profit }}</bdi></th></tr>{% endfor %}</table></div>{% endblock %}
