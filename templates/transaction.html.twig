{% if not chosen %}
{% set everyday=['sale','receipt','supplier_payment','transfer','balance_transfer'] %}
<div class="task-links daily">{% for code in everyday %}<a href="{{ path('task',{branch:branch,task:code|replace({'_':'-'})}) }}">{{ tasks[code]|ui }}</a>{% endfor %}</div>
{% for group,items in groups %}
{% set extra=items|filter((label,code)=>code not in everyday and info.role!='viewer') %}
{% if extra %}<details><summary>{{ group|ui }}</summary><div class="task-links">{% for code,label in extra %}<a href="{{ path('task',{branch:branch,task:code|replace({'_':'-'})}) }}">{{ label|ui }}</a>{% endfor %}</div></details>{% endif %}
{% endfor %}
{% elseif preview %}
<p><strong>{{ (chosen)|ui }}</strong> · {{ f.reference }} · {{ f.day }}</p>
<p>{{ 'Check the accounts and amounts below, then confirm to save this transaction.'|ui }}</p>
<div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Account movement'|ui }}</th><th>{{ 'Value in'|ui }} <bdi>{{ info.base }}</bdi></th></tr>{% for e in preview %}<tr><td>{{ names[e.account]|default(e.account) }}</td><td><bdi>{{ e.native }}</bdi> {{ e.currency }}</td><td><bdi>{{ e.base }}</bdi></td></tr>{% endfor %}</table></div>
<form method="post">{{ include('csrf.html.twig') }}{% for k,v in f %}{% if k not in ['_token','mode'] %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endif %}{% endfor %}
<button name="mode" value="confirm">{{ 'Confirm posting'|ui }}</button> <button class="secondary" name="mode" value="edit">{{ 'Edit details'|ui }}</button>{% if f.amend|default(0) or f.back|default('') %} <a href="{{ f.back|default('') ? app.request.basePath~f.back : path('office',{branch:branch,section:'d',doc:f.amend}) }}">{{ 'Cancel'|ui }}</a>{% endif %}</form>
{% else %}
{% set fields={
 sale:'customer supplier',reissue:'customer supplier',refund:'customer supplier',receipt:'customer cash',customer_refund:'customer cash',
 supplier_payment:'supplier cash',supplier_refund:'supplier cash',liability:'creditor',loan:'creditor cash',repayment:'creditor cash',payroll:'employee',
 salary_payment:'employee cash',advance:'employee cash',recovery:'employee',transfer:'cash destination',opening_party:'customer supplier'
} %}
{% set accounts=(fields[kind]|default('cash'))|split(' ') %}
{% set travel=kind in ['sale','reissue','refund'] %}
{% set linked=kind in ['reissue','refund','receipt','customer_refund','supplier_payment','supplier_refund','repayment','salary_payment','reverse'] %}
{% set cancel=f.back|default('') ? app.request.basePath~f.back : (f.amend|default(0) ? path('office',{branch:branch,section:'d',doc:f.amend}) : '') %}
{% if cancel %}<a href="{{ cancel }}">{{ '← Back'|ui }}</a>{% else %}<a href="{{ path('office',{branch:branch,section:'new'}) }}">{{ '← Choose a different task'|ui }}</a>{% endif %}
<form class="card task-form" method="post">{{ include('csrf.html.twig') }}
{% if f.amend|default(0) %}<h2>{{ 'Amend document'|ui }} D-{{ f.amend }}</h2><input type="hidden" name="amend" value="{{ f.amend }}">{% endif %}{% if f.back|default('') %}<input type="hidden" name="back" value="{{ f.back }}">{% endif %}
<input type="hidden" name="kind" value="{{ kind }}"><input type="hidden" name="request_key" value="{{ f.request_key|default(key) }}">
{% if kind=='opening_party' %}<p>{{ 'Choose either a customer or a supplier.'|ui }}</p>{% endif %}
<div class="grid">
{% if kind=='balance_transfer' %}<p>{{ 'The From account is credited and the To account is debited, for example when a client pays a supplier or creditor directly.'|ui }}</p>
{% for field,label in {from:'From account',to:'To account'} %}<label>{{ label|ui }}<select name="{{ field }}" required><option value="">{{ 'Choose an account'|ui }}</option>{% for group in ['customer','supplier','creditor','employee'] %}{% set options=parties|filter(p=>p.kind==group) %}{% if options %}<optgroup label="{{ group|capitalize|ui }}">{% for a in options %}<option value="{{ group }}:{{ a.id }}" data-currency="{{ a.currency }}" {{ f[field]|default('')==group~':'~a.id?'selected' }}>{{ a.name }} · {{ a.currency }}</option>{% endfor %}</optgroup>{% endif %}{% endfor %}</select></label>{% endfor %}
{% else %}{% for field in (kind=='reverse'?[]:(travel?['customer']:accounts)) %}{{ include('account_field.html.twig') }}{% endfor %}{% endif %}
{% if travel %}<label>{{ 'Service'|ui }}<select name="service"><option value="">{{ 'Choose service'|ui }}</option>{% if f.service|default('') and f.service not in services|map(s=>s.name) %}<option value="{{ f.service }}" selected>{{ f.service|ui }}</option>{% endif %}{% for s in services %}<option value="{{ s.name }}" {{ f.service|default('')==s.name?'selected' }}>{{ s.name|ui }}</option>{% endfor %}</select></label>
{% endif %}
{% if kind!='reverse' %}<label>{{ (kind=='sale'?'Selling price':(kind=='reissue'?'Additional selling price':'Amount'))|ui }}{% if 'cash' in accounts or kind=='balance_transfer' %} <bdi data-cash-currency></bdi>{% endif %}<input name="amount" inputmode="decimal" value="{{ f.amount|default('') }}" {{ not travel and kind!='payroll'?'required' }}><small>{{ (kind=='payroll'?'Leave blank to use the employee’s saved salary.':'')|ui }}</small></label>
{% if kind=='balance_transfer' %}<label data-rate>{{ 'To amount'|ui }} <bdi data-to-currency></bdi> {{ '(optional)'|ui }}<input name="to_amount" inputmode="decimal" value="{{ f.to_amount|default('') }}"><small>{{ 'Enter the agreed amount in the To account currency, or leave blank to convert at the rate.'|ui }}</small></label>
{% elseif 'cash' not in accounts %}<label>{{ 'Amount currency'|ui }}<select name="currency">{% for code,n in prec %}<option {{ f.currency|default(info.base)==code?'selected' }}>{{ code }}</option>{% endfor %}</select></label>{% endif %}{% endif %}
{% if travel %}{% set field='supplier' %}{{ include('account_field.html.twig') }}
<label>{{ 'Supplier cost (optional)'|ui }}<input name="cost" inputmode="decimal" value="{{ f.cost|default('') }}"><small>{{ 'Select the supplier when entering a cost.'|ui }}</small></label>
<label>{{ 'Supplier cost currency'|ui }}<select name="cost_currency">{% for code,n in prec %}<option {{ f.cost_currency|default(f.currency|default(info.base))==code?'selected' }}>{{ code }}</option>{% endfor %}</select></label>
{% endif %}
{% if not travel and kind not in ['reverse','transfer','balance_transfer'] %}<label data-rate>{{ 'Exchange rate'|ui }} ({{ 'units per 1'|ui }} <bdi>{{ info.base }}</bdi>) {{ '(optional)'|ui }}<input name="override" inputmode="decimal" value="{{ f.override|default('') }}"><small>{{ 'Enter the agreed rate when the bank or safe and the account use different currencies. Leave blank to use the saved rate.'|ui }}</small></label>{% elseif kind in ['transfer','balance_transfer'] %}<label data-rate>{{ 'Exchange rate'|ui }} ({{ 'units per 1'|ui }} <bdi>{{ info.base }}</bdi>) {{ '(optional)'|ui }}<input name="override" inputmode="decimal" value="{{ f.override|default('') }}"><small>{{ 'Only needed between accounts in different currencies.'|ui }}</small></label>{% endif %}
{% if kind in ['fee','liability'] %}<label>{{ 'Expense category'|ui }}<select name="category"><option value="">{{ 'Other expenses'|ui }}</option>{% for c in expenseCategories %}<option value="{{ c }}" {{ f.category|default('')==c?'selected' }}>{{ c|ui }}</option>{% endfor %}</select></label>{% endif %}
<label>{{ 'Transaction date'|ui }}<input type="date" name="day" value="{{ f.day|default(today) }}" required></label>
<label>{{ 'Reference'|ui }}<input name="reference" maxlength="160" placeholder="{{ 'Generated if blank'|ui }}" value="{{ f.reference|default('') }}"></label>
{% if travel %}{% for k,label in {ticket:'Ticket number',pnr:'Booking reference (PNR)',passenger:'Passenger name',airline:'Airline',route:'Route'} %}<label>{{ (label)|ui }}<input name="{{ k }}" value="{{ f[k]|default('') }}"></label>{% endfor %}{% endif %}
{% if linked %}<label>{{ 'Original document'|ui }} {{ (kind not in ['reverse','reissue','refund']?'(optional)')|ui }}<input name="related" inputmode="numeric" pattern="[0-9]+" list="documents" placeholder="{{ 'Choose or enter the D-number digits'|ui }}" value="{{ f.related|default('') }}" {{ kind in ['reverse','reissue','refund']?'required' }}>
{% set openFor={receipt:['customer:',['sale','reissue','opening_party']],supplier_payment:['supplier:',['sale','reissue','opening_party']],salary_payment:['employee:',['payroll']],repayment:['creditor:',['liability','loan']],customer_refund:['customer:',['refund']],supplier_refund:['supplier:',['refund']]}[kind]|default(null) %}
<datalist id="documents">{% if openFor %}{% for o in aging|filter(o=>o.account starts with openFor[0] and o.kind in openFor[1]) %}<option value="{{ o.id }}" data-account="{{ o.account|split(':')|last }}" data-currency="{{ o.currency }}" data-amount="{{ o.amount|trim('-','left') }}">D-{{ o.id }} · {{ names[o.account]|default(o.account) }} · {{ o.reference }} · {{ 'Outstanding'|ui }} {{ o.amount }} {{ o.currency }}</option>{% endfor %}{% else %}{% for d in recentDocs %}<option value="{{ d.id }}">D-{{ d.id }} · {{ d.reference }} · {{ d.day }}</option>{% endfor %}{% endif %}</datalist>
{% if kind not in ['reverse','reissue','refund'] %}<small>{{ 'Choose an invoice to reduce its outstanding balance, or leave blank for a payment on account.'|ui }}</small>{% endif %}</label>{% endif %}
</div>
{% if travel %}<div class="grid"><label data-rate>{{ 'Exchange rate'|ui }} ({{ 'units per 1'|ui }} <bdi>{{ info.base }}</bdi>) {{ '(optional)'|ui }}<input name="override" inputmode="decimal" value="{{ f.override|default('') }}"><small>{{ 'Enter the agreed rate when the price, the client account or the supplier account use different currencies. Leave blank to use the saved rate.'|ui }}</small></label>
<label data-rate>{{ 'Converted amount in'|ui }} <bdi>{{ info.base }}</bdi> {{ '(optional)'|ui }}<input name="converted" inputmode="decimal" value="{{ f.converted|default('') }}"></label></div>{% endif %}
{% if kind=='payroll' %}<div class="grid">{% for k,label in {allowance:'Allowances',deduction:'Deductions'} %}<label>{{ (label)|ui }} {{ '(optional)'|ui }}<input name="{{ k }}" inputmode="decimal" value="{{ f[k]|default('') }}"></label>{% endfor %}</div>{% endif %}
{% if kind=='reverse' %}<label>{{ 'Reason for deleting'|ui }}<input name="note" required value="{{ f.note|default('') }}"></label>
{% endif %}
{% if f.amend|default(0) %}<label>{{ 'Reason for correction'|ui }}<input name="reason" required value="{{ f.reason|default('') }}"></label>{% endif %}
<div class="actions"><button name="mode" value="save">{{ (f.amend|default(0)?'Save changes':(kind=='sale'?'Save sale':'Save transaction'))|ui }}</button> <button class="secondary" name="mode" value="preview">{{ 'Check amounts before saving'|ui }}</button>{% if cancel %}<a href="{{ cancel }}">{{ 'Cancel'|ui }}</a>{% endif %}</div>
</form>
<script>
// Default the amount currency to the chosen account's currency, so an SDG amount is not saved as USD by mistake.
document.querySelectorAll('.task-form select[name=customer],.task-form select[name=supplier],.task-form select[name=creditor],.task-form select[name=employee]').forEach(function(select) {
    const form=select.form, target=form.elements[select.name==='supplier' && form.elements.cost_currency ? 'cost_currency' : 'currency'];
    if (target) { select.addEventListener('change',function() { const option=select.selectedOptions[0]; if (option && option.dataset.currency) { target.value=option.dataset.currency; } }); }
});
(function() {
    const form=document.querySelector('.task-form'), el=form.elements, accounts=['customer','supplier','creditor','employee','cash','destination','from','to'].filter(n=>el[n]);
    const currencyOf=name=>{ const o=el[name] && el[name].selectedOptions[0]; return o && o.dataset.currency; };
    let remembered=null; try { remembered=localStorage.getItem('mt-cash-{{ branch }}'); } catch (e) {}
    // Pick the only account, or the bank or safe used last time on this device.
    accounts.forEach(function(name) {
        const select=el[name], real=[...select.options].filter(o=>o.value && o.value!=='new');
        if (select.value) { return; }
        if (real.length===1) { select.value=real[0].value; }
        else if (name==='cash' && real.some(o=>o.value===remembered)) { select.value=remembered; }
    });
    function refresh() {
        const used=new Set(accounts.map(currencyOf).filter(Boolean));
        if (el.currency) { used.add(el.currency.value); }
        if (el.cost_currency && el.cost && el.cost.value.trim()) { used.add(el.cost_currency.value); }
        form.querySelectorAll('[data-rate]').forEach(function(row) { row.hidden=used.size<2 && !row.querySelector('input').value.trim(); });
        form.querySelectorAll('[data-cash-currency]').forEach(function(tag) { const c=currencyOf(el.from ? 'from' : 'cash'); tag.textContent=c ? '('+c+')' : ''; });
        form.querySelectorAll('[data-to-currency]').forEach(function(tag) { const c=currencyOf('to'); tag.textContent=c ? '('+c+')' : ''; });
        if (el.from) { [...el.to.options].forEach(o=>{ o.disabled=!!o.value && o.value===el.from.value; }); }
        if (el.destination) { [...el.destination.options].forEach(o=>{ o.disabled=!!o.value && o.value===el.cash.value; }); }
        const list=document.getElementById('documents'), owner=accounts.find(n=>n!=='cash');
        if (list && owner) { [...list.options].forEach(o=>{ o.disabled=!!el[owner].value && !!o.dataset.account && o.dataset.account!==el[owner].value; }); }
    }
    // Choosing an open invoice fills in its customer or supplier and, in the same currency, the amount due.
    if (el.related) { el.related.addEventListener('change',function() {
        const owner=accounts.find(n=>n!=='cash'), o=[...document.querySelectorAll('#documents option')].find(o=>o.value===el.related.value);
        if (!o || !owner || !o.dataset.account) { return; }
        if (!el[owner].value) { el[owner].value=o.dataset.account; el[owner].dispatchEvent(new Event('change')); }
        if (el.amount && !el.amount.value && (!el.cash || currencyOf('cash')===o.dataset.currency)) { el.amount.value=o.dataset.amount; }
        refresh();
    }); }
    form.addEventListener('change',refresh); form.addEventListener('input',refresh); refresh();
    form.addEventListener('submit',function() { try { if (el.cash && el.cash.value) { localStorage.setItem('mt-cash-{{ branch }}',el.cash.value); } } catch (e) {} });
})();
</script>
{% if kind=='sale' %}
<script>
document.querySelectorAll('[data-new-account]').forEach(function(row) {
    const select=row.closest('form').elements[row.dataset.newAccount], input=row.querySelector('input');
    function sync() { row.hidden=select.value!=='new'; input.disabled=row.hidden; input.required=!row.hidden; }
    select.addEventListener('change',sync); sync();
});
const sale=document.querySelector('.task-form');
function checkSupplier(){sale.elements.supplier.required=Number(sale.elements.cost.value)>0;}
sale.elements.cost.addEventListener('input',checkSupplier);checkSupplier();
</script>
{% endif %}
{% endif %}
