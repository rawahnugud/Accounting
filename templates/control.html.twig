{% extends 'layout.html.twig' %}
{% set title='Admin control panel' %}
{% macro input(name,label,type='text') %}<label>{{ (label)|ui }}<input name="{{ name }}" type="{{ type }}" required></label>{% endmacro %}
{% macro select(name,label,values) %}<label>{{ (label)|ui }}<select name="{{ name }}" required>{% for value,text in values %}<option value="{{ value }}" {{ name=='kind' and app.request.query.get('kind')==value?'selected' }}>{{ (text)|ui }}</option>{% endfor %}</select></label>{% endmacro %}
{% macro manage(row,directory) %}
<details><summary>{{ 'Manage account'|ui }}</summary><form method="post">{{ include('csrf.html.twig') }}
<input type="hidden" name="directory" value="{{ directory }}"><input type="hidden" name="record" value="{{ row.id }}">
<label>{{ 'Name'|ui }}<input name="name" value="{{ row.name }}" maxlength="200" required></label>
{% if directory!='bank' %}<label>{{ 'Details'|ui }}<textarea name="detail">{{ row.detail }}</textarea></label>{% endif %}
<label>{{ 'Reason for correction'|ui }}<input name="reason" required></label>
<button name="action" value="Edit account">{{ 'Edit account'|ui }}</button>
<button name="action" value="Delete unused account">{{ 'Delete unused account'|ui }}</button></form></details>
{% endmacro %}
{% block content %}
{% set forms={
 'company':'Add company','branch':'Add branch','company profile':'Company details','numbering':'Document numbering','company name':'Rename company','branch name':'Rename branch','service category':'Add service category','credit limit':'Customer credit limit','supplier limit':'Supplier credit limit','salary terms':'Employee salary terms','installment':'Schedule creditor repayment','currency':'Add currency','rate':'Set exchange rate','supplier reconciliation':'Reconcile supplier','cash':'Add bank or safe',
 'party':'Add customer, supplier, creditor or employee','user':'Create staff login','access':'Manage branch access','staff password':'Set staff password','rerate':'Re-rate past entries',
 'leave':'Record staff leave','leave decision':'Review pending leave','reconcile':'Reconcile bank or safe','revalue':'Revalue foreign balances','close period':'Close fiscal period'} %}
 {% set groups={'Banking and currencies':['cash','currency','rate','rerate','reconcile','revalue'],'Customers, suppliers and creditors':['party','credit limit','supplier limit','supplier reconciliation','installment'],'Staff and permissions':['user','access','staff password','salary terms','leave','leave decision'],'Company and accounting settings':['company profile','company name','service category','numbering','close period']} %}
{% set category=app.request.query.get('category','') %}
{% if category not in groups|keys %}{% set category='' %}{% endif %}
{% set focus=app.request.query.get('setup') %}
{% if focus not in forms|keys %}{% set focus='' %}{% endif %}
{% if not focus and not category %}<div class="task-links control-shortcuts">{% for slug,label in {'party':'Register client','user':'Register staff','rate':'Set exchange rate','cash':'Add bank or safe'} %}<a href="{{ path('control',{setup:slug,branch:branches[0].id|default(0),kind:'customer'}) }}">{{ label|ui }}</a>{% endfor %}<a href="{{ path('control',{setup:'party',kind:'supplier'}) }}">{{ 'Register supplier'|ui }}</a></div><p>{{ 'Available currencies'|ui }} · {% for currency in currencies %}<bdi>{{ currency.code }}</bdi>{{ not loop.last?' · ' }}{% endfor %}</p>{% endif %}
{% if focus or category %}<a href="{{ path('control') }}">← {{ 'Admin control panel'|ui }}</a>{% else %}<nav aria-label="{{ 'Settings sections'|ui }}">{% for heading,items in groups %}<a href="{{ path('control',{category:heading}) }}#settings-{{ loop.index }}" {% if category==heading %}aria-current="page"{% endif %}>{{ (heading)|ui }}</a>{% endfor %}</nav>{% endif %}
{% for heading,items in groups %}{% if (focus and focus in items) or (not focus and category==heading) %}<h2 id="settings-{{ loop.index }}">{{ (heading)|ui }}</h2><div class="grid">{% for action in items|filter(item=>not focus or item==focus) %}{% set label=forms[action] %}<details id="setup-{{ action|replace({' ':'-'}) }}" {{ app.request.query.get('setup')==action?'open' }}><summary>{{ (label)|ui }}</summary><form method="post">
{{ include('csrf.html.twig') }}<input type="hidden" name="action" value="{{ action }}">
{% if action in ['cash','party','user','access','rate','rerate','close period','branch name','numbering','revalue'] %}{% if branches|length==1 %}<input type="hidden" name="branch" value="{{ branches[0].id }}">{% else %}<label>{{ 'Branch'|ui }}<select name="branch" required>{% for b in branches %}<option value="{{ b.id }}" {{ app.request.query.get('branch')==b.id?'selected' }}>{{ b.company }} · {{ b.name }}</option>{% endfor %}</select></label>{% endif %}{% endif %}
{% if action in ['company','branch','cash','party','user','company name','branch name','service category'] %}{{ _self.input('name','Name') }}{% endif %}
{% if action in ['company','cash','party','rate','rerate'] %}<label>{{ (action=='company'?'Reporting currency':'Currency')|ui }}<select name="currency" required>{% if action in ['rate','rerate'] %}<option value="">{{ 'Choose a foreign currency'|ui }}</option>{% endif %}{% for c in currencies %}{% if action not in ['rate','rerate'] or branches|length!=1 or c.code!=branches[0].reporting_currency %}<option {{ action not in ['rate','rerate'] and c.code==branches[0].reporting_currency|default('USD')?'selected' }}>{{ c.code }}</option>{% endif %}{% endfor %}</select></label>{% endif %}
{% if action in ['branch','company name','company profile'] %}<label>{{ 'Company'|ui }}<select name="company">{% for c in companies %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['credit limit','supplier limit','salary terms','supplier reconciliation'] %}<label>{{ 'Account'|ui }}<select name="party">{% for p in parties %}{% if p.kind==(action=='credit limit'?'customer':(action=='salary terms'?'employee':'supplier')) %}<option value="{{ p.id }}" {{ app.request.query.get('account')=='supplier:'~p.id?'selected' }}>{{ p.name }} · {{ p.branch }} · {{ p.currency }}</option>{% endif %}{% endfor %}</select></label>{{ _self.input('amount',action in ['credit limit','supplier limit']?'Limit in account currency':(action=='salary terms'?'Base salary in employee currency':'Balance owed per supplier statement')) }}{% if action=='salary terms' %}{{ _self.input('title','Job title') }}{% endif %}{% endif %}
{% if action=='installment' %}<label>{{ 'Obligation'|ui }}<select name="document">{% for o in obligations %}<option value="{{ o.id }}">D-{{ o.id }} · {{ o.name }} · {{ o.reference }}</option>{% endfor %}</select></label>{{ _self.input('day','Due date','date') }}{{ _self.input('amount','Installment in creditor currency') }}{% endif %}
{% if action=='company profile' %}{% for field,label in {'address':'Address','contact':'Contact','registration':'Registration / tax number'} %}<label>{{ label|ui }}<input name="{{ field }}" {{ field!='registration'?'required' }} value="{{ companies|length==1?profiles[0][field]|default(''):'' }}"></label>{% endfor %}{% endif %}
{% if action=='numbering' %}{{ _self.input('prefix','Unique document prefix') }}{{ _self.input('next','Next number','number') }}{% endif %}
{% if action=='currency' %}{{ _self.input('code','Three-letter currency code') }}<label>{{ 'Decimal places (0–6)'|ui }}<input required name="precision" type="number" min="0" max="6" value="2"></label>{% endif %}
{% if action=='currency' and branches|length==1 %}<label>{{ 'Rate today (optional)'|ui }}<input name="initial_rate" inputmode="decimal"><small>{{ 'Currency units per one reporting unit'|ui }} ({{ branches[0].reporting_currency }})</small></label><input type="hidden" name="branch" value="{{ branches[0].id }}">{% endif %}
{% if action=='rate' %}{{ _self.input('rate','Currency units per one reporting unit') }}{% endif %}
{% if action=='revalue' %}<p>{{ 'Restates foreign-currency cash, customer, supplier, creditor and staff balances at this date’s rate. The adjustment reverses the next day.'|ui }}</p>{% endif %}
{% if action in ['rate','close period','reconcile','supplier reconciliation','revalue'] %}<label>{{ (action=='close period'?'Close through':'Effective date')|ui }}<input name="day" type="date" required value="{{ action=='close period'?'':app.request.query.get('day','now'|date('Y-m-d')) }}"></label>{% endif %}
{% if action=='cash' %}{{ _self.select('kind','Account type',{'bank':'Bank','safe':'Safe'}) }}{% endif %}
{% if action=='party' %}{{ _self.select('kind','Account type',{'customer':'Customer','supplier':'Supplier','creditor':'Creditor','employee':'Employee'}) }}<label>{{ 'Contact, job title or terms'|ui }}<input name="detail"></label>{% endif %}
{% if action=='user' %}{% if employees %}<label>{{ 'Employee profile'|ui }}<select name="employee_id"><option value="">{{ 'Create a profile with this login'|ui }}</option>{% for e in employees|filter(e=>not e.login_id) %}<option value="{{ e.id }}">{{ e.name }}</option>{% endfor %}</select></label>{% endif %}{{ _self.input('email','Email','email') }}{{ _self.input('password','Initial password (12–72 bytes)','password') }}{% endif %}
{% if action=='rerate' %}<p>{{ 'Re-posts each entry in the range at the new rate: the original is reversed and a corrected copy is saved. Invoices with linked payments are skipped and listed.'|ui }}</p>{{ _self.input('from','From','date') }}{{ _self.input('to','Through','date') }}{{ _self.input('rate','Currency units per one reporting unit') }}<label>{{ 'Only this customer or supplier (optional)'|ui }}<select name="account"><option value="">{{ 'All accounts'|ui }}</option>{% for p in parties|filter(p=>p.kind in ['customer','supplier']) %}<option value="{{ p.kind }}:{{ p.id }}">{{ p.name }} · {{ p.currency }}</option>{% endfor %}</select></label>{{ _self.input('reason','Reason for correction') }}{% endif %}
{% if action=='staff password' %}<label>{{ 'User'|ui }}<select name="user">{% for u in users %}<option value="{{ u.id }}">{{ u.name }} · {{ u.email }}</option>{% endfor %}</select></label>{{ _self.input('password','New password (12–72 bytes)','password') }}{% endif %}
{% if action=='access' %}<label>{{ 'User'|ui }}<select name="user">{% for u in users %}<option value="{{ u.id }}">{{ u.name }} · {{ u.email }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['user','access'] %}{{ _self.select('role','Role',action=='user'?{'cashier':'Sales','admin':'Administrator','viewer':'Viewer'}:{'cashier':'Sales','admin':'Administrator','viewer':'Viewer','revoke':'Remove branch access'}) }}<small>{{ 'Sales staff record every operation, edit and void entries and see all reports. Only administrators open the control panel.'|ui }}</small>{% endif %}
{% if action=='leave' %}<label>{{ 'Employee'|ui }}<select name="employee">{% for e in employees %}<option value="{{ e.id }}">{{ e.name }} · {{ e.branch }}</option>{% endfor %}</select></label>{{ _self.input('start','Start','date') }}{{ _self.input('end','End','date') }}{{ _self.input('detail','Reason') }}{% endif %}
{% if action=='leave decision' %}<label>{{ 'Request'|ui }}<select name="leave_id">{% for l in leave %}{% if l.state=='pending' %}<option value="{{ l.id }}">{{ l.name }} · {{ l.starts }} {{ 'to'|ui }} {{ l.ends }}</option>{% endif %}{% endfor %}</select></label>{{ _self.select('state','Decision',{'approved':'Approve','declined':'Decline'}) }}{% endif %}
{% if action=='reconcile' %}<label>{{ 'Account'|ui }}<select name="cash">{% for b in banks %}<option value="{{ b.id }}" {{ app.request.query.get('account')=='cash:'~b.id?'selected' }}>{{ b.branch }} · {{ b.name }} ({{ b.currency }})</option>{% endfor %}</select></label>{{ _self.input('amount','Statement closing balance') }}{% endif %}
<button>{{ (label)|ui }}</button></form></details>{% endfor %}</div>{% endif %}{% endfor %}
{% if not focus and (not category or category=='Customers, suppliers and creditors') %}<details><summary>{{ 'Account directory'|ui }}</summary><div class="scroll"><table><tr>{% if branches|length>1 %}<th>{{ 'Branch'|ui }}</th>{% endif %}<th>{{ 'Name'|ui }}</th><th>{{ 'Account type'|ui }}</th><th>{{ 'Currency'|ui }}</th><th>{{ 'Details'|ui }}</th></tr>{% for p in parties %}<tr>{% if branches|length>1 %}<td>{{ p.branch }}</td>{% endif %}<td><a href="{{ path('office',{branch:p.branch_id,section:'report',view:'statement',account:p.kind~':'~p.id}) }}">{{ p.name }}</a></td><td>{{ (p.kind)|ui }}</td><td>{{ p.currency }}</td><td>{{ p.job_title }} {{ p.detail }}{% if p.salary_minor is not null %} {{ '· Base salary'|ui }} {{ (p.salary_minor / (10 ** p.decimals))|number_format(p.decimals) }}{% endif %}{% if p.limit_minor is not null %} {{ '· Credit limit'|ui }} {{ (p.limit_minor / (10 ** p.decimals))|number_format(p.decimals) }}{% endif %}{{ _self.manage(p,'party') }}</td></tr>{% endfor %}</table></div>
</details>{% endif %}
{% if not focus and category=='Company and accounting settings' %}{% for p in profiles %}<p>{{ p.name }} · {{ p.address }} · {{ p.contact }} · {{ p.registration }}</p>{% endfor %}{% endif %}
{% if not focus and category=='Banking and currencies' %}{% for bank in banks %}<p>{{ bank.name }} · {{ bank.currency }}</p>{{ _self.manage(bank,'bank') }}{% endfor %}{% endif %}
{% if not focus and category=='Staff and permissions' %}<details><summary>{{ 'Leave register'|ui }}</summary>{% for l in leave %}<p>{{ l.name }} · {{ l.starts }} {{ 'to'|ui }} {{ l.ends }} · {{ (l.state)|ui }}</p>{% else %}<p>{{ 'No leave recorded.'|ui }}</p>{% endfor %}
</details>{% endif %}
{% if not focus and category=='Company and accounting settings' %}<details><summary>{{ 'Recent audit events'|ui }}</summary><div class="scroll"><table><tr><th>{{ 'Date (UTC)'|ui }}</th><th>{{ 'Staff'|ui }}</th><th>{{ 'Action'|ui }}</th><th>{{ 'Details'|ui }}</th></tr>{% for a in audit %}<tr><td>{{ a.created_at }}</td><td>{{ a.name }}</td><td>{{ (a.action)|ui }}</td><td>{{ a.detail }}</td></tr>{% endfor %}</table></div></details>
{% endif %}
{% endblock %}
