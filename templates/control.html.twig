{% extends 'layout.html.twig' %}
{% set title='Admin control panel' %}
{% macro input(name,label,type='text') %}<label>{{ label }}<input name="{{ name }}" type="{{ type }}" required></label>{% endmacro %}
{% macro select(name,label,values) %}<label>{{ label }}<select name="{{ name }}" required>{% for value,text in values %}<option value="{{ value }}">{{ text }}</option>{% endfor %}</select></label>{% endmacro %}
{% block content %}
{% set forms={
 'company':'Add company','branch':'Add branch','company profile':'Company details','numbering':'Document numbering','company name':'Rename company','branch name':'Rename branch','service category':'Add service category','credit limit':'Customer credit limit','supplier limit':'Supplier credit limit','salary terms':'Employee salary terms','installment':'Schedule creditor repayment','currency':'Add currency','rate':'Set exchange rate','supplier reconciliation':'Reconcile supplier','cash':'Add bank or safe',
 'party':'Add customer, supplier, creditor or employee','user':'Create staff login','access':'Manage branch access',
 'leave':'Record staff leave','leave decision':'Review pending leave','reconcile':'Reconcile bank or safe','close period':'Close fiscal period'} %}
<div class="grid">{% for action,label in forms %}<details><summary>{{ label }}</summary><form method="post">
{{ include('csrf.html.twig') }}<input type="hidden" name="action" value="{{ action }}">
{% if action in ['cash','party','user','access','rate','close period','branch name','numbering'] %}<label>Branch<select name="branch" required>{% for b in branches %}<option value="{{ b.id }}">{{ b.company }} · {{ b.name }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['company','branch','cash','party','user','company name','branch name','service category'] %}{{ _self.input('name','Name') }}{% endif %}
{% if action in ['company','cash','party','rate'] %}<label>{{ action=='company'?'Reporting currency':'Currency' }}<select name="currency">{% for c in currencies %}<option>{{ c.code }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['branch','company name','company profile'] %}<label>Company<select name="company">{% for c in companies %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['credit limit','supplier limit','salary terms','supplier reconciliation'] %}<label>Account<select name="party">{% for p in parties %}{% if p.kind==(action=='credit limit'?'customer':(action=='salary terms'?'employee':'supplier')) %}<option value="{{ p.id }}">{{ p.name }} · {{ p.branch }} · {{ p.currency }}</option>{% endif %}{% endfor %}</select></label>{{ _self.input('amount',action in ['credit limit','supplier limit']?'Limit in account currency':(action=='salary terms'?'Base salary in employee currency':'Balance owed per supplier statement')) }}{% if action=='salary terms' %}{{ _self.input('title','Job title') }}{% endif %}{% endif %}
{% if action=='installment' %}<label>Obligation<select name="document">{% for o in obligations %}<option value="{{ o.id }}">D-{{ o.id }} · {{ o.name }} · {{ o.reference }}</option>{% endfor %}</select></label>{{ _self.input('day','Due date','date') }}{{ _self.input('amount','Installment in creditor currency') }}{% endif %}
{% if action=='company profile' %}{{ _self.input('address','Address') }}{{ _self.input('contact','Contact') }}{{ _self.input('registration','Registration / tax number') }}{% endif %}
{% if action=='numbering' %}{{ _self.input('prefix','Unique document prefix') }}{{ _self.input('next','Next number','number') }}{% endif %}
{% if action=='currency' %}{{ _self.input('code','Three-letter currency code') }}{{ _self.input('precision','Decimal places (0–6)','number') }}{% endif %}
{% if action=='rate' %}{{ _self.input('rate','Currency units per one reporting unit') }}{% endif %}
{% if action in ['rate','close period','reconcile','supplier reconciliation'] %}{{ _self.input('day',action=='close period'?'Close through':'Effective date','date') }}{% endif %}
{% if action=='cash' %}{{ _self.select('kind','Account type',{'bank':'Bank','safe':'Safe'}) }}{% endif %}
{% if action=='party' %}{{ _self.select('kind','Account type',{'customer':'Customer','supplier':'Supplier','creditor':'Creditor','employee':'Employee'}) }}<label>Contact, job title or terms<input name="detail"></label>{% endif %}
{% if action=='user' %}{{ _self.input('email','Email','email') }}{{ _self.input('password','Initial password (12–72 bytes)','password') }}{% endif %}
{% if action=='access' %}<label>User<select name="user">{% for u in users %}<option value="{{ u.id }}">{{ u.name }} · {{ u.email }}</option>{% endfor %}</select></label>{% endif %}
{% if action in ['user','access'] %}{{ _self.select('role','Branch role',action=='user'?{'viewer':'Viewer','cashier':'Cashier'}:{'viewer':'Viewer','cashier':'Cashier','revoke':'Remove branch access'}) }}{% endif %}
{% if action=='leave' %}<label>Employee<select name="employee">{% for e in employees %}<option value="{{ e.id }}">{{ e.name }} · {{ e.branch }}</option>{% endfor %}</select></label>{{ _self.input('start','Start','date') }}{{ _self.input('end','End','date') }}{{ _self.input('detail','Reason') }}{% endif %}
{% if action=='leave decision' %}<label>Request<select name="leave_id">{% for l in leave %}{% if l.state=='pending' %}<option value="{{ l.id }}">{{ l.name }} · {{ l.starts }} to {{ l.ends }}</option>{% endif %}{% endfor %}</select></label>{{ _self.select('state','Decision',{'approved':'Approve','declined':'Decline'}) }}{% endif %}
{% if action=='reconcile' %}<label>Account<select name="cash">{% for b in banks %}<option value="{{ b.id }}">{{ b.branch }} · {{ b.name }} ({{ b.currency }})</option>{% endfor %}</select></label>{{ _self.input('amount','Statement closing balance') }}{% endif %}
<button>{{ label }}</button></form></details>{% endfor %}</div>
<h2>Account directory</h2><div class="scroll"><table><tr><th>Branch</th><th>Name</th><th>Account type</th><th>Currency</th><th>Details</th></tr>{% for p in parties %}<tr><td>{{ p.branch }}</td><td>{{ p.name }}</td><td>{{ p.kind }}</td><td>{{ p.currency }}</td><td>{{ p.job_title }} {{ p.detail }}{% if p.salary_minor is not null %} · Base salary {{ (p.salary_minor / (10 ** p.decimals))|number_format(p.decimals) }}{% endif %}{% if p.limit_minor is not null %} · Credit limit {{ (p.limit_minor / (10 ** p.decimals))|number_format(p.decimals) }}{% endif %}</td></tr>{% endfor %}</table></div>
{% for p in profiles %}<p>{{ p.name }} · {{ p.address }} · {{ p.contact }} · {{ p.registration }}</p>{% endfor %}
<h2>Leave register</h2>{% for l in leave %}<p>{{ l.name }} · {{ l.starts }} to {{ l.ends }} · {{ l.state }}</p>{% else %}<p>No leave recorded.</p>{% endfor %}
<h2>Recent audit events</h2><div class="scroll"><table><tr><th>Date (UTC)</th><th>Staff</th><th>Action</th><th>Details</th></tr>{% for a in audit %}<tr><td>{{ a.created_at }}</td><td>{{ a.name }}</td><td>{{ a.action }}</td><td>{{ a.detail }}</td></tr>{% endfor %}</table></div>
{% endblock %}
