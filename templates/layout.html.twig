<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#85144b">
<title>{{ title }} · Midnight Travel Accounting</title>
<link rel="stylesheet" href="{{ app.request.basePath }}/assets/accounting.css?v=2">
</head>
<body class="{{ app.user ? 'staff' : 'guest' }}">
<a class="skip" href="#workspace">Skip to content</a>
<header class="mast"><div class="frame mast-inner">
<a class="brand" href="{{ path(app.user ? 'home' : 'login') }}">
<img src="{{ app.request.basePath }}/assets/midnight-travel.png" width="1500" height="439" alt="Midnight Travel"><span>Accounting</span></a>
{% if app.user %}
<nav class="primary" aria-label="Main navigation">
{% set areas = {'home':'Branches'} %}
{% if is_granted('ROLE_ADMIN') %}{% set areas=areas|merge({'overview':'Group overview','control':'Admin control panel'}) %}{% endif %}
{% for route,name in areas %}<a href="{{ path(route) }}" {% if app.request.attributes.get('_route')==route %}aria-current="page"{% endif %}>{{ name }}</a>{% endfor %}
</nav>
<form class="logout" action="{{ path('logout') }}" method="post">{{ include('csrf.html.twig') }}<button>Sign out</button></form>
{% endif %}
</div></header>
<main id="workspace" class="frame">
<div class="page-heading"><h1>{{ title }}</h1></div>
{% for error in app.flashes('error') %}<p role="alert">{{ error }}</p>{% endfor %}
{% for message in app.flashes('message') %}<p role="status">{{ message }}</p>{% endfor %}
{% block content %}{% endblock %}
</main></body></html>
