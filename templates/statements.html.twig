{% extends 'layout.html.twig' %}
{% set title=('Management reports'|ui)~' · '~info.name %}
{% block content %}<nav><a href="{{ path('office',{branch:branch,section:'dashboard'}) }}">{{ 'Branch dashboard'|ui }}</a><a href="{{ path('office',{branch:branch,section:'report'}) }}">{{ 'General ledger'|ui }}</a></nav>
<p class="screen-context">{{ info.company }} · <bdi>{{ info.base }}</bdi> · {{ from }} {{ 'to'|ui }} {{ to }}</p>
<form class="grid"><label>{{ 'From'|ui }}<input name="from" type="date" value="{{ from }}"></label><label>{{ 'Through'|ui }}<input name="to" type="date" value="{{ to }}"></label><label>{{ 'Profitability by'|ui }}<select name="group">{% for g in ['service','airline','employee','customer','supplier'] %}<option value="{{ g }}" {{ report.group==g?'selected' }}>{{ (g)|ui }}</option>{% endfor %}</select></label><button>{{ 'Run report'|ui }}</button></form>
<button onclick="window.print()">{{ 'Print / save PDF'|ui }}</button>
<article class="statement-paper management-paper"><div class="document-brand"><img src="{{ app.request.basePath }}/assets/midnight-travel.png" alt="Midnight Travel"><div><strong>{{ info.company }}</strong>{% if profile.address|default('') %}<div>{{ profile.address }}</div>{% endif %}{% if profile.contact|default('') %}<div>{{ profile.contact }}</div>{% endif %}<div>{{ info.name }} · {{ info.base }}</div></div></div><h2>{{ 'Management reports'|ui }}</h2><p><bdi>{{ from }}</bdi> – <bdi>{{ to }}</bdi></p>
<h2>{{ 'Profit and loss'|ui }}</h2><table class="report-values"><tbody>{% for account,value in report.profit %}<tr><th>{{ names[account]|default(account|ui) }}</th><td><bdi>{{ value }}</bdi></td></tr>{% else %}<tr><td colspan="2">{{ 'No income or expenses in this period.'|ui }}</td></tr>{% endfor %}<tr class="closing"><th>{{ 'Net profit'|ui }}</th><td><bdi>{{ netProfit }}</bdi></td></tr></tbody></table>
<h2>{{ 'Profitability by'|ui }} {{ (report.group)|ui }}</h2><div class="scroll"><table><tr><th>{{ (report.group|capitalize)|ui }}</th><th>{{ 'Sales'|ui }}</th><th>{{ 'Supplier cost'|ui }}</th><th>{{ 'Gross profit'|ui }}</th></tr>{% for r in report.performance %}<tr><td>{{ report.group in ['airline','customer','supplier','employee'] and r.label!='Unspecified' ? r.label : r.label|ui }}</td><td><bdi>{{ r.sales }}</bdi></td><td><bdi>{{ r.cost }}</bdi></td><td><bdi>{{ r.margin }}</bdi></td></tr>{% endfor %}</table></div>
<h2>{{ 'Balance sheet at'|ui }} {{ to }}</h2><table class="report-values"><tbody>{% for label,value in report.sheet %}<tr{{ label starts with 'Total' or label starts with 'Unbalanced' ? ' class="closing"' }}><th>{{ label|ui }}</th><td><bdi>{{ value }}</bdi></td></tr>{% endfor %}</tbody></table>
<h2>{{ 'Aging of open balances at'|ui }} {{ report.today }}</h2><div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Currency'|ui }}</th>{% for b in ['Not yet due','1–30 days','31–60 days','61–90 days','Over 90 days'] %}<th>{{ b|ui }}</th>{% endfor %}<th>{{ 'Total'|ui }}</th></tr>{% for r in report.aging %}<tr><td>{{ r.name }}</td><td><bdi>{{ r.currency }}</bdi></td>{% for v in r.buckets %}<td><bdi>{{ v }}</bdi></td>{% endfor %}<td><strong><bdi>{{ r.total }}</bdi></strong></td></tr>{% else %}<tr><td colspan="8">{{ 'No open customer or supplier balances.'|ui }}</td></tr>{% endfor %}</table></div>
<h2>{{ 'Cash movements'|ui }}</h2>{% for r in report.flows %}<p>{{ (r.kind|replace({'_':' '})|capitalize)|ui }} · {{ r.amount }}</p>{% else %}<p>{{ 'No cash movements in this period.'|ui }}</p>{% endfor %}
<h2>{{ 'Currency exposure at'|ui }} {{ to }}</h2><div class="scroll"><table><tr><th>{{ 'Currency'|ui }}</th><th>{{ 'Net position'|ui }}</th><th>{{ 'Carrying value ('|ui }}<bdi>{{ info.base }}</bdi>)</th></tr>{% for r in report.exposure %}<tr><td><bdi>{{ r.currency }}</bdi></td><td>{{ r.native }}</td><td>{{ r.base }}</td></tr>{% endfor %}</table></div></article>{% endblock %}
