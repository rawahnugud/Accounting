{% extends 'layout.html.twig' %}
{% set title=('Management reports'|ui)~' · '~info.name %}
{% block content %}<nav><a href="{{ path('office',{branch:branch,section:'dashboard'}) }}">{{ 'Branch dashboard'|ui }}</a><a href="{{ path('office',{branch:branch,section:'ledger'}) }}">{{ 'General ledger'|ui }}</a></nav>
<p class="screen-context">{{ info.company }} · {{ 'Total in'|ui }} <bdi>{{ info.view }}</bdi> · {{ from }} {{ 'to'|ui }} {{ to }}</p>
<form class="grid"><label>{{ 'From'|ui }}<input name="from" type="date" value="{{ from }}"></label><label>{{ 'Through'|ui }}<input name="to" type="date" value="{{ to }}"></label><label>{{ 'Period'|ui }}<select name="period"><option value="">{{ 'Custom dates'|ui }}</option>{% for p,l in {month:'This month',last:'Last month',quarter:'This quarter',lastquarter:'Last quarter',year:'This year',lastyear:'Last year'} %}<option value="{{ p }}">{{ l|ui }}</option>{% endfor %}</select></label><label>{{ 'Total in'|ui }}<select name="in">{% for c in info.views %}<option {{ info.view==c?'selected' }}>{{ c }}</option>{% endfor %}</select></label><label>{{ 'Profitability by'|ui }}<select name="group">{% for g in ['service','airline','employee','customer','supplier'] %}<option value="{{ g }}" {{ report.group==g?'selected' }}>{{ (g)|ui }}</option>{% endfor %}</select></label><label>{{ 'Customer or supplier'|ui }}<select name="account"><option value="">{{ 'All'|ui }}</option>{% for key,name in names %}{% if key matches '/^(customer|supplier|creditor):/' %}<option value="{{ key }}" {{ filter==key?'selected' }}>{{ name }}</option>{% endif %}{% endfor %}</select></label>
<fieldset class="report-options"><legend>{{ 'Currency columns'|ui }}</legend><input type="hidden" name="cols[]" value="">{% for c in allCurrencies %}<label><input type="checkbox" name="cols[]" value="{{ c }}" {{ c in currencies?'checked' }}> <bdi>{{ c }}</bdi></label>{% endfor %}</fieldset>
<fieldset class="report-options"><legend>{{ 'Sections'|ui }}</legend><input type="hidden" name="show[]" value="">{% for k,l in {profit:'Profit and loss',performance:'Profitability',sheet:'Balance sheet',aging:'Aging of open balances',flows:'Cash movements',exposure:'Currency exposure'} %}<label><input type="checkbox" name="show[]" value="{{ k }}" {{ k in shown?'checked' }}> {{ l|ui }}</label>{% endfor %}</fieldset><button>{{ 'Run report'|ui }}</button></form>
<button onclick="window.print()">{{ 'Print / save PDF'|ui }}</button>
<article class="statement-paper management-paper"><div class="document-brand"><img src="{{ app.request.basePath }}/assets/midnight-travel.png" alt="Midnight Travel"><div><strong>{{ info.company }}</strong>{% if profile.address|default('') %}<div>{{ profile.address }}</div>{% endif %}{% if profile.contact|default('') %}<div>{{ profile.contact }}</div>{% endif %}<div>{{ info.name }} · {{ info.view }}</div></div></div><h2>{{ 'Management reports'|ui }}</h2><p><bdi>{{ from }}</bdi> – <bdi>{{ to }}</bdi>{% if filter %} · {{ names[filter] }}{% endif %}</p>
{% set dualHead %}<thead><tr><th></th>{% for c in currencies %}<th><bdi>{{ c }}</bdi></th>{% endfor %}<th>{{ 'Total in'|ui }} <bdi>{{ info.view }}</bdi></th></tr></thead>{% endset %}
{% if 'profit' in shown %}<h2>{{ 'Profit and loss'|ui }}</h2><div class="scroll"><table class="report-values dual-values">{{ dualHead }}<tbody>{% for account,value in report.profit %}<tr><th>{{ names[account]|default(account|ui) }}</th>{% for c in currencies %}<td><bdi>{{ report.dual.profit[account][c]|default('') }}</bdi></td>{% endfor %}<td><bdi>{{ value }}</bdi></td></tr>{% else %}<tr><td colspan="{{ currencies|length+2 }}">{{ 'No income or expenses in this period.'|ui }}</td></tr>{% endfor %}<tr class="closing"><th>{{ 'Net profit'|ui }}</th>{% for c in currencies %}<td><bdi>{{ report.dual.net['Net profit'][c]|default('') }}</bdi></td>{% endfor %}<td><bdi>{{ netProfit }}</bdi></td></tr></tbody></table></div>
<p class="report-note">{% if info.view==info.base %}{{ 'Each currency column shows the real amounts in that currency. The total converts everything at the rates used when each entry was posted.'|ui }}{% else %}{{ 'Each currency column shows the real amounts in that currency. In the total, amounts already in this currency stay as they are and the rest convert at the rate on the end date.'|ui }}{% endif %}{% if filter %} {{ 'Profit, profitability and cash movements include only documents for the chosen account. The balance sheet, aging and exposure cover the whole branch.'|ui }}{% endif %}</p>{% endif %}
{% if 'performance' in shown %}<h2>{{ 'Profitability by'|ui }} {{ (report.group)|ui }} (<bdi>{{ info.view }}</bdi>)</h2><div class="scroll"><table><tr><th>{{ (report.group|capitalize)|ui }}</th><th>{{ 'Sales'|ui }}</th><th>{{ 'Supplier cost'|ui }}</th><th>{{ 'Gross profit'|ui }}</th></tr>{% for r in report.performance %}<tr><td>{{ report.group in ['airline','customer','supplier','employee'] and r.label!='Unspecified' ? r.label : r.label|ui }}</td><td><bdi>{{ r.sales }}</bdi></td><td><bdi>{{ r.cost }}</bdi></td><td><bdi>{{ r.margin }}</bdi></td></tr>{% endfor %}</table></div>{% endif %}
{% if 'sheet' in shown %}<h2>{{ 'Balance sheet at'|ui }} {{ to }}</h2><div class="scroll"><table class="report-values dual-values">{{ dualHead }}<tbody>{% for label,value in report.sheet %}{% set total=label starts with 'Total' or label starts with 'Unbalanced' %}<tr{{ total ? ' class="closing"' }}><th>{{ label|ui }}</th>{% for c in currencies %}<td><bdi>{{ total ? '' : report.dual.sheet[label][c]|default('') }}</bdi></td>{% endfor %}<td><bdi>{{ value }}</bdi></td></tr>{% endfor %}</tbody></table></div>{% endif %}
{% if 'aging' in shown %}<h2>{{ 'Aging of open balances at'|ui }} {{ report.today }}</h2><div class="scroll"><table><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Currency'|ui }}</th>{% for b in ['Not yet due','1–30 days','31–60 days','61–90 days','Over 90 days'] %}<th>{{ b|ui }}</th>{% endfor %}<th>{{ 'Total'|ui }}</th></tr>{% for r in report.aging %}<tr><td>{{ r.name }}</td><td><bdi>{{ r.currency }}</bdi></td>{% for v in r.buckets %}<td><bdi>{{ v }}</bdi></td>{% endfor %}<td><strong><bdi>{{ r.total }}</bdi></strong></td></tr>{% else %}<tr><td colspan="8">{{ 'No open customer or supplier balances.'|ui }}</td></tr>{% endfor %}</table></div>{% endif %}
{% if 'flows' in shown %}<h2>{{ 'Cash movements'|ui }}</h2>{% if report.flows %}<div class="scroll"><table class="report-values dual-values">{{ dualHead }}<tbody>{% for kind,value in report.flows %}<tr><th>{{ (kind|replace({'_':' '})|capitalize)|ui }}</th>{% for c in currencies %}<td><bdi>{{ report.dual.flows[kind][c]|default('') }}</bdi></td>{% endfor %}<td><bdi>{{ value }}</bdi></td></tr>{% endfor %}</tbody></table></div>{% else %}<p>{{ 'No cash movements in this period.'|ui }}</p>{% endif %}{% endif %}
{% if 'exposure' in shown %}<h2>{{ 'Currency exposure at'|ui }} {{ to }}</h2><div class="scroll"><table><tr><th>{{ 'Currency'|ui }}</th><th>{{ 'Net position'|ui }}</th><th>{{ 'Carrying value ('|ui }}<bdi>{{ info.view }}</bdi>)</th></tr>{% for r in report.exposure %}<tr><td><bdi>{{ r.currency }}</bdi></td><td>{{ r.native }}</td><td>{{ r.base }}</td></tr>{% endfor %}</table></div>{% endif %}</article>{% endblock %}
