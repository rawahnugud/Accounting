{% extends 'layout.html.twig' %}
{% set title = 'Forgot password' %}
{% block content %}
{% if sent %}<p role="status">{{ 'If this email belongs to a staff login, a reset link is on its way. It works for one hour.'|ui }}</p>
{% else %}<p>{{ 'Enter your sign-in email and we will send a link to choose a new password.'|ui }}</p>
<form method="post">{{ include('csrf.html.twig') }}
<p><label for="email">{{ 'Email'|ui }}</label><input id="email" name="email" type="email" autocomplete="username" required></p>
<button>{{ 'Send reset link'|ui }}</button></form>{% endif %}
<p><a href="{{ path('login') }}">{{ 'Back to sign in'|ui }}</a></p>
<p><small>{{ 'No email? Ask an administrator to set a new password from the control panel.'|ui }}</small></p>
{% endblock %}
