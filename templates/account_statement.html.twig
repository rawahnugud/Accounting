{% extends 'layout.html.twig' %}
{% set title='Account statements' %}
{% macro balance(item) %}<bdi>{{ item.amount }}</bdi> {{ item.side|ui }}{% endmacro %}
{# Zero debits and credits stay blank so the real amounts stand out. #}
{% macro amount(value) %}{% if value matches '/[1-9]/' %}<bdi>{{ value }}</bdi>{% endif %}{% endmacro %}
{% block content %}
{% set here=app.request.pathInfo~(app.request.queryString?'?'~app.request.queryString:'') %}
<form class="statement-tools card" method="get">
<div class="grid"><label id="statement-search" hidden>{{ 'Find account by name'|ui }}<input type="search" id="account-search" autocomplete="off"></label><label>{{ 'Account'|ui }}<select id="statement-account" name="account" required>
<option value="">{{ 'Choose an account'|ui }}</option>
{% for group,items in groups %}<optgroup label="{{ group|ui }}">{% for key,a in items %}<option value="{{ key }}" {{ selected==key?'selected' }}>{{ a.name }} · {{ a.currency }}</option>{% endfor %}</optgroup>{% endfor %}
</select></label><label>{{ 'From'|ui }}<input name="from" type="date" value="{{ from }}" required></label><label>{{ 'Through'|ui }}<input name="to" type="date" value="{{ to }}" required></label></div>
<div class="actions"><button>{{ 'Show statement'|ui }}</button><button class="secondary" name="period" value="month">{{ 'This month'|ui }}</button><button class="secondary" name="period" value="last">{{ 'Last month'|ui }}</button><button class="secondary" name="period" value="year">{{ 'Year to date'|ui }}</button></div></form>
<script>
(() => {
 const field=document.getElementById('account-search'), menu=document.getElementById('statement-account');
 const groups=Array.from(menu.querySelectorAll('optgroup')).map(group=>group.cloneNode(true));
 document.getElementById('statement-search').hidden=false;
 field.addEventListener('input',()=>{
   const current=menu.value, term=field.value.trim().toLocaleLowerCase();
   menu.querySelectorAll('optgroup').forEach(group=>group.remove());
   for(const original of groups){
     const group=original.cloneNode(true);
     Array.from(group.children).forEach(option=>{if(!(group.label+' '+option.textContent).toLocaleLowerCase().includes(term))option.remove();});
     if(group.children.length)menu.append(group);
   }
   menu.value=current;
   if(menu.selectedIndex<0)menu.selectedIndex=0;
 });
 // Choosing an account opens its statement; Enter in the search opens the first match.
 menu.addEventListener('change',()=>{if(menu.value)menu.form.submit();});
 field.addEventListener('keydown',event=>{
   if(event.key!=='Enter')return;
   event.preventDefault();
   const first=menu.querySelector('option[value]:not([value=""])');
   if(first){menu.value=first.value;menu.form.submit();}
 });
})();
</script>
{% if error %}<p role="alert">{{ error|ui }}</p>{% endif %}
{% if not statement and balances %}<div class="statement-balances">
{% for kind,title in {customer:'Customers who owe us or hold credit',supplier:'Suppliers we owe or have paid ahead',cash:'Banks and safes'} %}{% if balances[kind]|default([]) %}
<section class="card"><h2>{{ title|ui }}</h2><div class="scroll"><table><thead><tr><th>{{ 'Account'|ui }}</th><th>{{ 'Balance'|ui }}</th></tr></thead><tbody>
{% for b in balances[kind] %}<tr><td><a href="{{ path('office',{branch:branch,section:'statement',account:b.key,from:from,to:to}) }}">{{ b.name }}</a></td><td><bdi>{{ b.amount }}</bdi> {{ b.side|ui }} <bdi>{{ b.currency }}</bdi></td></tr>{% endfor %}
</tbody></table></div></section>{% endif %}{% endfor %}
</div>{% endif %}
{% if statement %}
<div class="actions"><button type="button" onclick="window.print()">{{ 'Print / save PDF'|ui }}</button>
<a href="{{ path('office',{branch:branch,section:'statement',account:selected,from:from,to:to,download:'csv'}) }}">{{ 'Download CSV'|ui }}</a>
{% set party=selected|split(':') %}
{% if info.role!='viewer' and party[0] in ['customer','supplier'] %}<a class="button" href="{{ path('task',{branch:branch,task:party[0]=='customer'?'receipt':'supplier-payment',(party[0]):party[1],back:here}) }}">{{ (party[0]=='customer'?'Record receipt':'Pay supplier')|ui }}</a>{% endif %}
{% if statement.lines|length>1 %}<label class="statement-find">{{ 'Find in this statement'|ui }}<input type="search" id="line-search" autocomplete="off" placeholder="{{ 'PNR, ticket, reference or amount'|ui }}"></label>{% endif %}
</div>
<article class="statement-paper">
<div class="document-brand"><img src="{{ app.request.basePath }}/assets/midnight-travel.png" alt="Midnight Travel"><div><strong>{{ info.company }}</strong>{% if profile.address|default('') %}<div>{{ profile.address }}</div>{% endif %}{% if profile.contact|default('') %}<div>{{ profile.contact }}</div>{% endif %}</div></div>
<h2>{{ 'Account statement'|ui }}</h2>
<div class="statement-meta"><div><small>{{ account.group|ui }}</small><strong>{{ account.name }}</strong></div>
<div><small>{{ 'Statement period'|ui }}</small><bdi>{{ from }}</bdi> – <bdi>{{ to }}</bdi></div>
<div><small>{{ 'Account currency'|ui }}</small><bdi>{{ account.currency }}</bdi></div></div>
<div class="statement-figures">{% for label,value in {'Opening balance':statement.opening,'Closing balance':statement.closing} %}<div><small>{{ label|ui }}</small><strong>{{ _self.balance(value) }} <bdi>{{ account.currency }}</bdi></strong></div>{% endfor %}</div>
<div class="scroll"><table class="statement-table"><thead><tr><th>{{ 'Date'|ui }}</th><th>{{ 'Document and reference'|ui }}</th><th>{{ 'Activity'|ui }}</th><th class="num">{{ 'Debit'|ui }}</th><th class="num">{{ 'Credit'|ui }}</th><th class="num">{{ 'Balance'|ui }}</th>{% if info.role!='viewer' %}<th class="no-print"></th>{% endif %}</tr></thead><tbody>
{% set edit=info.role!='viewer' %}
<tr><td><bdi>{{ from }}</bdi></td><td colspan="4" class="label">{{ 'Opening balance'|ui }}</td><td class="num">{{ _self.balance(statement.opening) }}</td>{% if edit %}<td class="no-print"></td>{% endif %}</tr>
{% for line in statement.lines %}<tr data-line><td><bdi>{{ line.day }}</bdi></td><td>{% if line.doc %}<a href="{{ path('office',{branch:branch,section:'d',doc:line.doc,back:here}) }}"><bdi>{{ line.number }}</bdi></a>{% else %}<bdi>{{ line.number }}</bdi>{% endif %}<small>{{ line.reference }}</small></td><td>{{ line.operation|ui }}{% if line.pnr %}<small>PNR <bdi>{{ line.pnr }}</bdi></small>{% endif %}{% if line.ticket %}<small>{{ 'Ticket'|ui }} <bdi>{{ line.ticket }}</bdi></small>{% endif %}</td><td class="num">{{ _self.amount(line.debit) }}</td><td class="num">{{ _self.amount(line.credit) }}</td><td class="num">{{ _self.balance(line.balance) }}</td>{% if edit %}<td class="no-print">{% if line.doc %}<a href="{{ path('office',{branch:branch,section:'edit',doc:line.doc,back:here}) }}">{{ 'Edit'|ui }}</a> · <a href="{{ path('office',{branch:branch,section:'d',doc:line.doc,back:here}) }}#change">{{ 'Delete'|ui }}</a>{% endif %}</td>{% endif %}</tr>
{% else %}<tr><td colspan="{{ edit?7:6 }}" class="label">{{ 'No activity in this period.'|ui }}</td></tr>{% endfor %}
<tr id="no-match" hidden><td colspan="{{ edit?7:6 }}" class="label">{{ 'No lines match your search.'|ui }}</td></tr>
<tr class="closing"><td><bdi>{{ to }}</bdi></td><th colspan="2">{{ 'Closing balance'|ui }}</th><td class="num"><bdi>{{ statement.debits }}</bdi></td><td class="num"><bdi>{{ statement.credits }}</bdi></td><td class="num">{{ _self.balance(statement.closing) }}</td>{% if edit %}<td class="no-print"></td>{% endif %}</tr></tbody></table></div>
{% if account.group in ['Customer','Supplier'] %}<p class="balance-note">{% if statement.closing_minor==0 %}{{ 'This account is settled as of the closing date.'|ui }}{% elseif account.group=='Customer' %}{{ (statement.closing_minor>0?'Amount due from customer':'Credit in customer’s favour')|ui }}{% else %}{{ (statement.closing_minor<0?'Amount payable to supplier':'Supplier prepayment or credit')|ui }}{% endif %}{% if statement.closing_minor!=0 %} · <bdi>{{ statement.closing.amount }} {{ account.currency }}</bdi>{% endif %}</p>{% endif %}
<footer>{{ 'Issued on'|ui }} <bdi>{{ today }}</bdi>{% if profile.registration|default('') %} · {{ 'Registration / tax number'|ui }} {{ profile.registration }}{% endif %}</footer>
</article>
<script>
(() => {
 const field=document.getElementById('line-search');
 if(!field)return;
 const rows=Array.from(document.querySelectorAll('.statement-table tr[data-line]')), none=document.getElementById('no-match');
 field.addEventListener('input',()=>{
   const term=field.value.trim().toLocaleLowerCase().replace(/,/g,'');
   let shown=0;
   rows.forEach(row=>{const hit=row.textContent.toLocaleLowerCase().replace(/,/g,'').includes(term);row.hidden=!hit;shown+=hit;});
   none.hidden=shown>0;
 });
})();
</script>
{% endif %}
{% endblock %}
