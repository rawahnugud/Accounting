{% extends 'layout.html.twig' %}
{% set title = 'Choose a new password' %}
{% block content %}
{% if error %}<p role="alert">{{ error|ui }}</p>{% endif %}
{% if valid %}<form method="post">{{ include('csrf.html.twig') }}
<p><label for="password">{{ 'New password (12–72 bytes)'|ui }}</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required></p>
<p><label for="confirm">{{ 'Repeat the new password'|ui }}</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" maxlength="72" required></p>
<button>{{ 'Save new password'|ui }}</button></form>{% else %}<p><a href="{{ path('forgot_password') }}">{{ 'Ask for a new reset link'|ui }}</a></p>{% endif %}
{% endblock %}
